#!/bin/bash
# pi-run <session-id> <role> <promptfile> [extra pi args...]: one pi session on the VM.
# Installed as ~/bin/pi-run on the VM by a shim that execs this file.
# <role> picks provider and model from config/models.json via bin/model-for and is recorded as the
# session name role:<role>, which bin/check-models reads back. It takes no provider or model: a name that is
# not a role in the config exits 2 with model-for's error, so the config stays the only model choice.
# Appends the one onigiri policy file to every session's system prompt.
# one live session per id: refuses (exit 3) while $ONIGIRI_ROOT/run/<id>.pid (default /srv/onigiri) is alive or another
# pi-run wrapper for <id> is running. PI_RUN_DRY=1 checks and exits 0 without starting pi.
# Once it owns the id, any exit writes the exit code to $ONIGIRI_ROOT/review/<id>/run.rc.
# On pi's exit it runs hosts/vm/wake.py, which wakes onigiri only when rc is not 0 (pi-failed, best effort), and exits with pi's rc.
# The pidfile names this wrapper, so TERM or HUP to it is passed on to pi as the same signal.
pkg="$(cd "$(dirname "$0")/../.." && pwd)"
if [ -z "${ZSTACK_ENSURED:-}" ]; then "$pkg/bin/ensure-package-main" >&2 || exit 4; ZSTACK_ENSURED=1 exec "$0" "$@"; fi; unset ZSTACK_ENSURED
sid=$1
case $sid in ''|*/*) echo "pi-run: bad session id: $sid" >&2; exit 2;; esac
[ $# -ge 3 ] || { echo "usage: pi-run <session-id> <role> <promptfile> [extra pi args...]" >&2; exit 2; }
role=$2
pm=$("$pkg/bin/model-for" "$role") || exit 2
[ -r "$3" ] && [ ! -d "$3" ] || { echo "pi-run: cannot read prompt file $3" >&2; exit 2; }
provider=${pm% *}; model=${pm#* }
rd=${ONIGIRI_ROOT:-/srv/onigiri}/run; mkdir -p "$rd"
starttime() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }
# launch lock: mkdir is atomic, so two near-simultaneous launches can't both pass the checks.
lock=$rd/$sid.lock
if ! mkdir "$lock" 2>/dev/null; then
  age=$(( $(date +%s) - $(stat -c %Y "$lock" 2>/dev/null || echo 0) ))
  if [ "$age" -gt 300 ]; then rmdir "$lock" 2>/dev/null; mkdir "$lock" 2>/dev/null || { echo "pi-run: $sid launch lock busy" >&2; exit 3; }
  else echo "pi-run: $sid is being launched by another call (lock ${age}s old); not starting a second" >&2; exit 3; fi
fi
trap 'rmdir "$lock" 2>/dev/null' EXIT
# pidfile holds "pid starttime"; pi renames its process title, so the start time is what proves the pid is still ours.
if [ -f "$rd/$sid.pid" ]; then
  read -r old ost < "$rd/$sid.pid"
  if [ -n "${old:-}" ] && [ -n "${ost:-}" ] && [ "$(starttime "$old")" = "$ost" ]; then
    echo "pi-run: $sid already running (pid $old); not starting a second" >&2; exit 3
  fi
fi
# any other wrapper whose command line runs pi-run for this id (excluding this process and its ancestors).
anc=" $$ "; p=$$
while [ "$p" -gt 1 ] 2>/dev/null; do p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null || echo 1); anc="$anc$p "; done
for p in $(pgrep -f -- "pi-run $sid( |\$)"); do
  case "$anc" in *" $p "*) continue;; esac
  [ "$(cat /proc/$p/comm 2>/dev/null)" = bash ] || continue
  echo "pi-run: $sid already running (wrapper pid $p); not starting a second" >&2; exit 3
done
[ -n "${PI_RUN_DRY:-}" ] && { echo "pi-run: dry run, would start $sid as role $role: $provider $model"; exit 0; }
# From here every exit, a failed setup or pi's own end, leaves run.rc in the session's review dir, which the pickup reads.
# The traps go in before the pidfile names this process, so nothing can stop it unrecorded once it owns the id.
rv=${ONIGIRI_ROOT:-/srv/onigiri}/review/$sid; mkdir -p "$rv"; rm -f "$rv/run.rc"
# A signal before pi is forked ends the launcher; after, it goes to pi. pre is $! before the fork, so a signal between
# the fork and child=$! still finds pi, and a job .profile might start is never mistaken for it.
child=; pre=
fwd() { local c=$child; [ -z "$c" ] && [ -n "$pre" ] && [ "x$!" != "$pre" ] && c=$!; if [ -n "$c" ]; then kill -"$1" "$c" 2>/dev/null; else exit "$2"; fi; }
trap 'rc=$?; [ -n "$lock" ] && rmdir "$lock" 2>/dev/null; echo $rc > "$rv/run.rc"' EXIT
trap 'fwd TERM 143' TERM; trap 'fwd HUP 129' HUP
echo "$$ $(starttime $$)" > "$rd/$sid.pid"
rmdir "$lock" 2>/dev/null; lock=
if [ -r "$HOME/.profile" ]; then . "$HOME/.profile" >/dev/null 2>&1; fi
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
"$pkg/bin/ensure-extensions" >&2 || { rm -f "$rd/$sid.pid"; exit 4; }
POLICY=/srv/onigiri/policy.md
args=("--session-id" "$sid" "--provider" "$provider" "--model" "$model" "--name" "role:$role")
if [ -r "$POLICY" ]; then args+=("--append-system-prompt" "$POLICY"); fi
shift 2
export ONIGIRI_WAKE="$pkg/hosts/vm/wake.py" ONIGIRI_MERGE_OWNED=${ONIGIRI_MERGE_OWNED:-trycua/cua}
# a `merge: allowed` line in the brief lets rule-guard pass `gh pr ready`; only the brief decides, never the caller's env
ONIGIRI_READY_ALLOWED=0; grep -qx 'merge: allowed' "$1" && ONIGIRI_READY_ALLOWED=1; export ONIGIRI_READY_ALLOWED
# Background pi so a trap can forward signals; an async job starts with INT ignored, so the subshell restores it
# (bash 5) and <&0 keeps stdin, as the old exec did. A terminal's Ctrl-C reaches pi through the process group.
pre=x$!
( trap - INT; exec pi "${args[@]}" "${@:2}" -p "$(cat "$1")" ) <&0 & child=$!
trap : INT   # outlive the Ctrl-C to send the wake
while :; do wait "$child"; rc=$?; kill -0 "$child" 2>/dev/null || break; done
"$ONIGIRI_WAKE" --exit "$rc" "$sid" || true
exit "$rc"
