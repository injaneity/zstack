#!/usr/bin/env python3
import fcntl
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone

PKG = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
USAGE = (
    "  plan                       one pass: print what to launch and what was skipped, as JSON, and queue the launches\n"
    "  plan --dry                 the same, writing nothing\n"
    "  plan start <id>            reserve a queued item before launching its thread; refused when another pass has it\n"
    "  plan claim <id> <thread>   the thread now working a started item\n"
    "  plan requeue <id>          a started item whose thread did not start goes back in the queue\n"
    "  plan done <id> [<pr>...]   a claimed item's thread finished; the PR numbers it opened\n"
    "  plan list                  the queue as it stands"
)
_l = importlib.machinery.SourceFileLoader("policy", os.path.join(PKG, "bin", "policy"))
policy = importlib.util.module_from_spec(importlib.util.spec_from_loader(_l.name, _l))
_l.exec_module(policy)
STEPS = {"start": ("queued", "starting"), "claim": ("starting", "claimed"), "requeue": ("starting", "queued"),
         "done": ("claimed", "done")}
STALE_S = 15 * 60
EMPTY = {"items": {}}


def root():
    return os.path.abspath(os.path.expanduser(os.environ.get("ONIGIRI_ROOT") or policy.load()["host"]["root"]))


def gh(errors, *args):
    p = subprocess.run(["gh", *args], capture_output=True, text=True)
    if p.returncode:
        errors.append(f"gh {' '.join(args[:3])}: {(p.stderr or p.stdout).strip()[-150:]}")
        return []
    try:
        return json.loads(p.stdout)
    except ValueError:
        errors.append(f"gh {' '.join(args[:3])}: not JSON")
        return []


def holds(text):
    h = {"hold": set(), "skip": set(), "review_only": set(), "read": text is not None}
    for line in (text or "").splitlines():
        f = [x.strip() for x in line.split("|")]
        if line.lstrip().startswith("#") or len(f) < 2:
            continue
        if f[0] == "hold" and f[1].lstrip("#").isdigit():
            h["hold"].add(int(f[1].lstrip("#")))
        elif f[0] in ("skip-author", "review-only"):
            h["skip" if f[0] == "skip-author" else "review_only"].add(f[1].lower())
    return h


def bot(author):
    return bool(author.get("is_bot")) or author["login"].startswith("app/") or author["login"].endswith("[bot]")


def red(pr, gate):
    return any((c.get("name") or c.get("context")) == gate and (c.get("conclusion") or c.get("state")) in ("FAILURE", "ERROR")
               for c in pr.get("statusCheckRollup") or [])


def candidates(errors, pol):
    repo, me, short = pol["merge"]["repo"], pol["people"]["me"], pol["merge"]["repo"].split("/")[1]
    out = []
    for i in gh(errors, "issue", "list", "-R", repo, "--assignee", me, "--state", "open", "--limit", "1000",
                "--json", "number,title,url,createdAt,labels,closedByPullRequestsReferences,author"):
        out.append(dict(id=f"{short}-{i['number']}", kind="issue", n=i["number"], head=None, author=i["author"], title=i["title"],
                        url=i["url"], created=i["createdAt"], labels=[x["name"] for x in i["labels"]],
                        linked=[x["number"] for x in i.get("closedByPullRequestsReferences") or []]))
    for p in gh(errors, "pr", "list", "-R", repo, "--state", "open", "--search", f"review-requested:{me}", "--limit", "1000",
                "--json", "number,title,url,createdAt,labels,headRefOid,author"):
        out.append(dict(id=f"{short}-{p['number']}-review-{p['headRefOid'][:7]}", kind="review", n=p["number"], head=p["headRefOid"],
                        author=p["author"], title=p["title"], url=p["url"], created=p["createdAt"],
                        labels=[x["name"] for x in p["labels"]], linked=[]))
    for p in gh(errors, "pr", "list", "-R", repo, "--state", "open", "--author", me, "--limit", "1000",
                "--json", "number,title,url,createdAt,labels,headRefOid,author,isDraft,statusCheckRollup"):
        if red(p, pol["merge"]["gate_check"]) and not p["isDraft"]:
            out.append(dict(id=f"{short}-{p['number']}-fix-{p['headRefOid'][:7]}", kind="fix", n=p["number"], head=p["headRefOid"],
                            author=p["author"], title=p["title"], url=p["url"], created=p["createdAt"],
                            labels=[x["name"] for x in p["labels"]], linked=[]))
    return sorted(out, key=lambda c: ("urgent" not in c["labels"], c["created"] or "9", c["id"]))


def open_prs(errors, repo):
    return {p["number"] for p in gh(errors, "pr", "list", "-R", repo, "--state", "open", "--limit", "3000", "--json", "number")}


def rule(c, h, prs, items, cap):
    if not h["read"]:
        return "holds-unreadable"
    mine = items.get(c["id"])
    if mine and mine["state"] != "queued":
        return mine["state"]
    items = {k: v for k, v in items.items() if k != c["id"]}
    if c["kind"] != "fix" and (bot(c["author"]) or c["author"]["login"].lower() in h["skip"]):
        return "held"
    if "hold" in c["labels"] or (c["kind"] != "issue" and c["n"] in h["hold"]) or any(n in h["hold"] for n in c["linked"]):
        return "held"
    if c["kind"] == "issue" and any(n in prs for n in c["linked"]):
        return "pr"
    live = {n for i in items.values() if i["state"] != "done" for n in [i["n"], *i.get("prs", [])]}
    if c["n"] in live or any(n in live for n in c["linked"]):
        return "overlap"
    if c["kind"] == "fix" and sum(1 for i in items.values() if i["kind"] == "fix" and i["n"] == c["n"]) >= cap:
        return "owner"
    return None


def task(c, h, pol):
    repo, me, iss = pol["merge"]["repo"], pol["people"]["me"], pol["issues"]
    head = f" at head {c['head']}" if c["head"] else ""
    if c["kind"] == "issue":
        return (f"{repo}#{c['n']}: {c['title']}\n{c['url']}\n\nKind: fix in {repo}, picked from the issues assigned to {me}. "
                f"Read the issue and its thread, fix it with a test, and open a PR whose body says `{iss['fixes'].format(issue=c['n'])}`.")
    if c["kind"] == "fix":
        return (f"{repo}#{c['n']}{head}: {c['title']}\n{c['url']}\n\nKind: our PR is red at a head we pushed. Diagnose the "
                "failing checks, fix the cause, push, and have the verifier check the new head. If main or another PR already "
                "has its change, close it instead and say what replaced it.")
    salvage = pol["review"]["outside"] == "salvage"
    outside = "salvage a fixable PR as a new PR of ours that credits them, instead of requesting changes" if salvage else \
        "request changes on a fixable PR, and do not rewrite it as a PR of ours"
    who = "teammate (review-only: a first review and nothing else)" if c["author"]["login"].lower() in h["review_only"] else \
        f"outside contributor ({outside})"
    text = (f"{repo}#{c['n']}{head} by {c['author']['login']}, a {who}: {c['title']}\n{c['url']}\n\nKind: first review, "
            f"requested of {me}. Run playbooks/pull-requests.md Verify. Post nothing under the owner's name: put every comment "
            "for the author under a `drafts:` section of your final report.")
    if not salvage:
        return text
    return (f"{text}\nA salvage PR's body carries `{iss['salvaged_from'].format(pr=c['n'])}` and a "
            f"`{iss['fixes'].format(issue='<n>')}` line for each issue #{c['n']} fixes or was opened for, so the forge closes "
            "them when the salvage merges.")


def thread_for(c, items):
    owners = [i["thread"] for i in items.values() if i.get("thread") and c["n"] in i.get("prs", [])]
    return owners[-1] if c["kind"] == "fix" and owners else None


def decide(cands, h, prs, items, pol, template):
    launch, skipped, items = [], [], {k: dict(v) for k, v in items.items()}
    recover = sorted(k for k, v in items.items() if v["state"] == "starting" and age(v["at"]) >= STALE_S)
    for c in cands:
        why = rule(c, h, prs, items, pol["ci"]["fix_attempts"])
        if why:
            skipped.append({"id": c["id"], "why": why})
            continue
        brief = template.format(id=c["id"], task=task(c, h, pol), clone=pol["host"]["clone"])
        launch.append({"id": c["id"], "kind": c["kind"], "thread": thread_for(c, items), "brief": brief})
        items[c["id"]] = {"state": "queued", "kind": c["kind"], "n": c["n"], "thread": None, "prs": [], "at": now()}
    return launch, skipped, recover, items


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def age(at):
    return (datetime.now(timezone.utc) - datetime.strptime(at, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)).total_seconds()


def read_text(path):
    try:
        with open(os.path.expanduser(path)) as f:
            return f.read()
    except OSError:
        return None


def read_state(path):
    text = read_text(path)
    return json.loads(text) if text else json.loads(json.dumps(EMPTY))


def write_state(path, state):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=1, sort_keys=True)
        f.write("\n")
    os.replace(tmp, path)


def locked(fn):
    os.makedirs(root(), exist_ok=True)
    with open(os.path.join(root(), "queue.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = os.path.join(root(), "queue.json")
        state = read_state(path)
        out, changed = fn(state)
        if changed:
            write_state(path, state)
        return out


def run_pass(dry):
    pol, errors = policy.load(), []
    template = read_text(os.path.join(PKG, "orchestrator", "brief.md"))
    h = holds(read_text(pol["host"]["holds"]))
    cands, prs = candidates(errors, pol), open_prs(errors, pol["merge"]["repo"])

    def go(state):
        launch, skipped, recover, items = decide([] if errors else cands, h, prs, state["items"], pol, template)
        state["items"] = items
        return {"launch": launch, "recover": recover, "skipped": skipped, "errors": errors}, bool(launch) and not dry
    return locked(go)


def mark(step, ident, thread=None, prs=()):
    was, to = STEPS[step]

    def go(state):
        item = state["items"].get(ident)
        if not item:
            raise policy.PolicyError(f"no queued item {ident}")
        if item["state"] != was:
            raise policy.PolicyError(f"{ident} is {item['state']}, not {was}")
        item.update(state=to, thread=thread or item["thread"], prs=sorted({*item["prs"], *prs}), at=now())
        return item, True
    return locked(go)


def main(argv):
    try:
        if argv in ([], ["--dry"]):
            out = run_pass(bool(argv))
            print(json.dumps(out, indent=1))
            return 1 if out["errors"] else 0
        if len(argv) == 2 and argv[0] in ("start", "requeue"):
            return print(json.dumps(mark(argv[0], argv[1]))) or 0
        if len(argv) == 3 and argv[0] == "claim":
            return print(json.dumps(mark("claim", argv[1], thread=argv[2]))) or 0
        if len(argv) >= 2 and argv[0] == "done" and all(re.fullmatch(r"\d+", x) for x in argv[2:]):
            return print(json.dumps(mark("done", argv[1], prs=[int(x) for x in argv[2:]]))) or 0
        if argv == ["list"]:
            return print(json.dumps(locked(lambda s: (s["items"], False)), indent=1)) or 0
    except policy.PolicyError as e:
        print(f"plan: {e}", file=sys.stderr)
        return 1
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
