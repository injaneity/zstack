#!/usr/bin/env python3
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from datetime import datetime
from zoneinfo import ZoneInfo

PKG = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
USAGE = (
    "  hourly [--linear CUA-1,CUA-2]   STEP 0: this host's and its peers' runs, slots, launch host and the fingerprint.\n"
    '                                  Prints one `skip:` line and nothing else when nothing changed since `hourly done`.\n'
    '  hourly done [--linear ...]      after the pass: store the fingerprint and the snapshot status answers come from\n'
    '  hourly log <host> <action> <item> <reason...>   append one pickup.log row (ts_sgt host action item reason free_gb)\n'
    '  hourly launch <id> <host> <reason...>           start review/<id>/brief.md on <host> while its pool has room (counted\n'
    '                                                  under slots.lock), then log the launch; else log a wait and exit 3\n'
    "  hourly brief <id>               this host's review/<id>/brief.md, for a launch from a peer\n"
    "  hourly pools                    every host's running runs per pool as JSON, and the hosts whose runs are unknown\n"
    "  hourly queue                    first reopen the thread that pushed each of our PRs red after the merge job's rerun\n"
    "                                  (bin/pi-run ci on its host), then start every host's queued runs on that host,\n"
    "                                  oldest since= first, while its pool has room: fresh ones, and continuations (a 429's,\n"
    "                                  a red PR's) in their own session once resume_at has passed (PI_RUN_DRY=1: plan only)\n"
    "  hourly on <host> <package path> [args...]       run this package's file (bin/pi-run, hosts/vm/merge_job.py) there\n"
    "  hourly report <id>              the run's report.md, else the end of its run.log, with TOKEN lines dropped\n"
    "  hourly facts [--runs] | recv <id> [--drain]  what a peer is asked for over `on`: this host's facts as JSON; a brief on\n"
    "                                  stdin (--drain: the queue drain's start, the only one that may resume a 429'd run;\n"
    '                                  PI_RUN_COUNTED=1: `hourly launch` counted its pool already)'
)
_l = importlib.machinery.SourceFileLoader("pi_run", os.path.join(PKG, "bin", "pi-run"))
pr = importlib.util.module_from_spec(importlib.util.spec_from_loader(_l.name, _l))
_l.exec_module(pr)
SGT = ZoneInfo("Asia/Singapore")
_policy = pr.conf()
FLOOR_GB, HUNG_MIN, BATCH_HOUR = (_policy["hourly"][k] for k in ("floor_gb", "hung_min", "batch_hour"))
MERGE_STALE_MIN = _policy["hourly"]["merge_stale_min"]
REPO, ME = _policy["merge"]["repo"], _policy["people"]["me"]
LAST_RUN = re.compile(r"(\S+) zstack (?:[0-9a-f]{40}|unknown) (ok|\d+ error\(s\))( paused)?")
SELF = pr.host_name() or "local"
PEER_PKG = ".pi/agent/git/github.com/injaneity/zstack"
HEAD = "# onigiri hourly pickup decisions, append-only. one line per decision, tab-separated:\n# ts_sgt\thost\taction\titem\treason\tfree_gb\n"


def now():
    return datetime.now(SGT).isoformat(timespec="minutes")


HOST = []


def root():
    if not HOST:
        HOST.extend(pr.host_env("list"))
        os.environ.update(HOST[0])
    return HOST[1].rsplit("/review", 1)[0]


def peers():
    root()
    return dict(w.split("=", 1) for w in HOST[0].get("ONIGIRI_PEERS", "").split() if "=" in w)


def run(cmd, **kw):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, **kw)
    except FileNotFoundError:
        return subprocess.CompletedProcess(cmd, 127, "", f"{cmd[0]}: not found on PATH (set it in the host file)\n")


def on(host, args, stdin=None, env=None):
    env = env or {}
    if host == SELF:
        return run([os.path.join(PKG, args[0]), *args[1:]], input=stdin, env={**os.environ, **env})
    if host not in peers():
        pr.die(2, f"no host {host}: this is {SELF}, peers {' '.join(peers()) or 'none'}")
    line = " ".join(f"{k}={shlex.quote(v)}" for k, v in {"ONIGIRI_HOST": host, **env}.items()) + \
        f" ~/{PEER_PKG}/{shlex.quote(args[0])} " + " ".join(map(shlex.quote, args[1:]))
    return run([*shlex.split(peers()[host]), line], input=stdin)


def activity_min(d):
    agent = os.environ.get("PI_CODING_AGENT_DIR") or os.path.expanduser("~/.pi/agent")
    sess = os.path.join(agent, "sessions", "--" + d.strip("/").replace("/", "-") + "--")
    paths = [os.path.join(d, "run.log")] + [os.path.join(sess, f) for f in (os.listdir(sess) if os.path.isdir(sess) else [])]
    return int((time.time() - max([os.path.getmtime(p) for p in paths if os.path.exists(p)] or [0])) // 60)


NUM = re.compile(r"(?:cua#|trycua/cua/(?:pull|issues)/|#)(\d{3,6})\b")


def facts(full=True):
    r, ls = root(), run([os.path.join(PKG, "bin", "pi-run"), "list"])
    if ls.returncode:
        return {"error": "pi-run list: " + pr.tail(ls)}
    out = ls.stdout
    runs, ids = {}, []
    for line in out.splitlines():
        sid, state, *kv = line.split()
        ids.append(sid)
        if state == "collected":
            continue
        d, f = os.path.join(r, "review", sid), dict(x.split("=", 1) for x in kv)
        brief = open(os.path.join(d, "brief.md"), errors="replace").read() if os.path.exists(os.path.join(d, "brief.md")) else ""
        f.update(state=state, pool=pr.read_json(os.path.join(d, "run.json"))["pool"],
                 nums=sorted({int(n) for n in NUM.findall(brief)}))
        if state == "running" and full:
            f["idle_min"] = activity_min(d)
        runs[sid] = f
    if not full:
        return {"runs": runs}
    parity = run([os.path.join(PKG, "hosts", "check-parity")], env={**os.environ, "ONIGIRI_ROOT": r})
    last = os.path.join(r, "tick", "last-run")
    try:
        merge = {"merge_last": open(last, errors="replace").read().strip()} if os.path.exists(last) else {}
    except OSError as e:
        merge = {"merge_last": f"unreadable: {e}"}
    holds = os.path.join(r, "hold-prs.txt")
    if os.path.isfile(holds) and os.environ.get("ONIGIRI_MERGE_HOST") == SELF:
        merge["holds"] = open(holds, errors="replace").read()
    return {"ids": ids, "sha": pr.sha(), "at_main": parity.returncode == 0, "parity": [x for x in parity.stdout.splitlines() if x.startswith("FAIL")],
            "free_gb": free_gb(r), "runs": runs, "pushed": pushed(os.path.join(r, "review")), **merge}


def pushed(review):
    rows = []
    for sid in sorted(os.listdir(review)) if os.path.isdir(review) else []:
        if os.path.isfile(p := os.path.join(review, sid, "pushed")):
            rows += [(f[2], f"{f[0]} {f[1]}", sid) for f in (x.split() for x in open(p, errors="replace"))
                     if len(f) == 3 and re.fullmatch(r"[0-9a-f]{40}", f[0])]
    return {key: [sid, at] for at, key, sid in sorted(rows)}


RED = re.compile(r"cua#(\d+) ([0-9a-f]{7,40}) wait who=session: (red after rerun: .*)")


def owners(hosts, waits, branch_of):
    out = []
    for w in waits:
        if not (m := RED.fullmatch(w)):
            continue
        gh = branch_of(m[1])
        hit = sorted((at, key.split()[0], h, sid) for h, f in hosts.items() for key, (sid, at) in (f.get("pushed") or {}).items()
                     if key.startswith(m[2]) and key == f"{gh[0]} {gh[1]}")
        _, sha, h, sid = hit[-1] if hit else (None, gh[0], None, None)
        out.append((m[1], sha, h, sid, m[3]))
    return out


def branch_of(n):
    p = run(["gh", "pr", "view", n, "-R", REPO, "--json", "headRefOid,headRefName"])
    try:
        d = json.loads(p.stdout) if not p.returncode else {}
    except ValueError:
        d = {}
    d = d if isinstance(d, dict) else {}
    return (d["headRefOid"], d["headRefName"]) if d.get("headRefOid") and d.get("headRefName") else ("unknown", "unknown")


def reopen(hosts, waits, dry):
    for n, sha, h, sid, why in owners(hosts, waits, branch_of):
        if sha == "unknown":
            print(f"red cua#{n}: gh pr view failed, so its thread is unknown this pass")
            continue
        if sid is None:
            print(f"red cua#{n} {sha[:9]}: no run pushed this head; file an unstick")
            continue
        if dry:
            print(f"would reopen {h} {sid} for cua#{n} at {sha[:9]}: {why}")
            continue
        p = on(h, ["bin/pi-run", "ci", sid, n, sha, why])
        if p.returncode == 0:
            print(f"reopen {h} {sid}: {p.stdout.strip()}")
            log(h, "ci-reopen", sid, f"cua#{n} at {sha[:9]}: {why}")
        else:
            err = pr.tail(p, None).removeprefix("pi-run: ")
            print(f"red cua#{n} {sha[:9]}: {err}" + ("; needs Zane" if "spent" in err else ""))


def free_gb(p):
    p = os.path.abspath(p)
    while not os.path.exists(p):
        p = os.path.dirname(p)
    return shutil.disk_usage(p).free // 2**30


def batch_due(r):
    t = datetime.now(SGT)
    rows = open(os.path.join(r, "pickup.log")).read().splitlines() if os.path.exists(os.path.join(r, "pickup.log")) else []
    done = any(x.startswith(t.date().isoformat()) and x.split("\t")[2:3] in (["preapprove-batch"], ["step9"]) for x in rows)
    return t.hour >= BATCH_HOUR and not done


def all_facts(full=True):
    hosts = {SELF: facts(full)}
    for h in peers():
        p = on(h, ["bin/hourly", "facts", *([] if full else ["--runs"])])
        try:
            hosts[h] = json.loads(p.stdout)
        except ValueError:
            hosts[h] = {"error": pr.tail(p)}
    return hosts


def slots(hosts):
    rs = [r for f in hosts.values() for r in f.get("runs", {}).values() if r["state"] == "running"]
    return {p: sum(r["pool"] == p for r in rs) for p in pr.POOLS}


def pool_at(hosts, host, sid, brief):
    run = hosts.get(host, {}).get("runs", {}).get(sid)
    return run["pool"] if run else pr.pool_of(brief, pr.field(brief, "role", "coding"))


def unknown(hosts):
    root()
    return [h for h, f in hosts.items() if "error" in f] + HOST[0].get("ONIGIRI_UNSEEN", "").split()


def paused(hosts, host):
    try:
        lines = open(os.path.join(root(), "auto-pause"), errors="replace").read().splitlines()
    except FileNotFoundError:
        return ""
    except OSError as e:
        return f"auto launches on {host} paused: auto-pause unreadable: {e.strerror}"
    for line in lines:
        f = line.split("#", 1)[0].split()
        if not f or f[0] != host:
            continue
        if len(f) == 1:
            return f"auto launches on {host} paused until its auto-pause row is removed"
        if len(f) != 4 or f[1] != "until":
            return f"auto launches on {host} paused: auto-pause row {line.strip()!r} is not `<host> [until <host> <id>]`"
        there, sid = f[2], f[3]
        if there not in hosts or "error" in hosts[there]:
            return f"auto launches on {host} paused until {there} {sid} ends; {there}'s runs are unknown"
        state = hosts[there].get("runs", {}).get(sid, {}).get("state", "collected")
        if state not in ("exited", "lost", "collected"):
            return f"auto launches on {host} paused until {there} {sid} ends ({state})"
    return ""


def auto_free(hosts):
    return 0 if unknown(hosts) else max(0, pr.conf("slots")["auto"] - slots(hosts)["auto"])


def slots_line(n):
    cap = pr.conf("slots")
    return f"auto {n['auto']}/{cap['auto']}, hand {n['hand']}/{cap['hand']}, quick {n['quick']} (no cap)"


def slots_lock():
    os.makedirs(root(), exist_ok=True)
    fd = os.open(os.path.join(root(), "slots.lock"), os.O_RDWR | os.O_CREAT, 0o644)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def snapshot(linear):
    hosts = all_facts()
    def gh(*a):
        p = run(["gh", "pr", "list", "-R", REPO, "--state", "open", "--limit", "2000", *a])
        if p.returncode:
            errors.append(f"gh pr list {a[0]} {a[1]}: " + pr.tail(p, 150))
        return json.loads(p.stdout) if not p.returncode and p.stdout.strip() else []
    errors = []
    ours = gh("--author", ME, "--json", "number,headRefOid")
    others = gh("--search", f"-author:{ME}", "--json", "number,author")
    waits = merge_waits(errors)
    mh = HOST[0].get("ONIGIRI_MERGE_HOST")
    return {"hosts": hosts, "linear": sorted(linear), "batch_due": batch_due(root()), "errors": errors, "waits": waits,
            "merge": merge_health(hosts[mh].get("merge_last")) if mh in hosts and "error" not in hosts[mh] else None,
            "ours": sorted(f"{p['number']}:{p['headRefOid'][:9]}" for p in ours),
            "others": sorted(f"{p['number']}:{p['author']['login']}" for p in others if not bot(p["author"]))}


def bot(author):
    return bool(author.get("is_bot")) or author["login"].startswith("app/") or author["login"].endswith("[bot]")


def merge_health(line):
    if not line:
        return "no last-run", "no tick/last-run on the merge host"
    m = LAST_RUN.fullmatch(line)
    try:
        age = int((time.time() - datetime.fromisoformat(m[1]).timestamp()) // 60) if m else None
    except ValueError:
        age = None
    if age is None or age < -5:
        return "unreadable", line
    state = "paused" if m[3] else "not ok" if m[2] != "ok" else "stale" if age > MERGE_STALE_MIN else "ok"
    return state, f"{line} ({age}m ago)"


def waiting(r):
    return r["state"] == "queued" and r.get("resume_at", "") > pr.utc()


def due(f, h):
    return f["state"] in ("exited", "lost") or (f["state"] == "queued" and not waiting(f)) or f.get("idle_min", 0) >= HUNG_MIN


def fingerprint(s):
    keep = {h: {"runs": {k: (v["state"], v.get("idle_min", 0) >= HUNG_MIN) for k, v in f.get("runs", {}).items()},
                "at_main": f.get("at_main"), "floor": f.get("free_gb", 0) >= FLOOR_GB, "error": "error" in f}
            for h, f in s["hosts"].items()}
    return hashlib.sha256(json.dumps([keep, s["linear"], s["ours"], s["others"], s["batch_due"], s["waits"],
                                      (s.get("merge") or [None])[0]],
                                     sort_keys=True).encode()).hexdigest()[:16]


def report(s, fp, last):
    print(f"hourly {now()} fingerprint {fp} (last {last.get('fp', 'none')} at {last.get('ts', 'never')})")
    for h, f in s["hosts"].items():
        if "error" in f:
            print(f"host {h}: unreachable: {f['error']}")
            continue
        print(f"host {h}: zstack {f['sha'][:9]} {'at main' if f['at_main'] else 'NOT at main: ' + '; '.join(f['parity'])}, free {f['free_gb']}G")
        for sid, r in sorted(f["runs"].items(), key=lambda x: (x[1]["state"], x[1].get("since", ""))):
            extra = " ".join(f"{k}={r[k]}" for k in ("rc", "since", "resume_at", "idle_min") if k in r and r[k] != "None")
            print(f"  {r['state']:<8} {sid} {r['pool']} {extra}{'  HUNG?' if r.get('idle_min', 0) >= HUNG_MIN else ''}")
    vm = [h for h, f in s["hosts"].items() if h != SELF and f.get("at_main") and f.get("free_gb", 0) >= FLOOR_GB
          and not paused(s["hosts"], h)]
    print(f"slots: {slots_line(slots(s['hosts']))}: auto free {auto_free(s['hosts'])}")
    for h in s["hosts"]:
        if why := paused(s["hosts"], h):
            print(f"pause: {why}")
    print(f"launch host: {vm[0] if vm else SELF} (a peer only at main with {FLOOR_GB}G free and no auto pause)")
    for e in s["errors"]:
        print(f"error: {e}: the PR lists are unknown this pass")
    todo = f"{len(s['linear'])}: {','.join(s['linear']) or 'none passed'}"
    print(f"prs: ours {len(s['ours'])} open, others {len(s['others'])} open; linear todo {todo}")
    print(f"preapprove batch: {'due' if s['batch_due'] else 'not due'}")
    if s.get("merge"):
        print(f"merge job: {s['merge'][0]}: {s['merge'][1]}")
    for head, who in (("needs-Zane", "zane"), ("unstick", "session")):
        hits = [x for x in s["waits"] if f" wait who={who}: " in x]
        print(f"merge job {head}: {len(hits) or 'none'}")
        own = {f"cua#{n} {sha[:9]}": f"{sid} on {h}" for n, sha, h, sid, _ in owners(s["hosts"], hits, branch_of) if sid}
        for x in hits:
            mine = own.get(" ".join(x.split()[:2]))
            print(f"  {x.replace(f' wait who={who}', '')}" + (f"  (thread {mine}: bin/hourly queue reopens it)" if mine else ""))
    print(f"next: {os.path.join(PKG, 'skills', 'onigiri-mode', 'playbooks', 'hourly.md')}")


def merge_waits(errors):
    root()
    h = HOST[0].get("ONIGIRI_MERGE_HOST")
    if not h:
        return []
    p = on(h, ["hosts/vm/merge_job.py", "--dry-run"])
    if p.returncode:
        errors.append(f"merge job dry run on {h}: " + pr.tail(p, 150))
    return sorted(x.split(" ", 1)[1] for x in p.stdout.splitlines() if x.startswith("dry-run ") and " wait who=" in x)


def log(host, action, item, reason):
    try:
        free = json.load(open(os.path.join(root(), "hourly-snapshot.json")))["hosts"][host]["free_gb"]
    except (OSError, ValueError, KeyError):
        free = "-"
    free = shutil.disk_usage(root()).free // 2**30 if host == SELF else free
    with open(os.path.join(root(), "pickup.log"), "a") as f:
        f.write((HEAD if not f.tell() else "") + "\t".join([now(), host, action, item, " ".join(reason.split()), str(free)]) + "\n")


def launch(sid, host, reason, send=True, drain=False):
    here = os.path.join(root(), "review", sid, "brief.md")
    send = send and host != SELF and os.path.exists(here)
    lock = None
    if not drain:
        lock = slots_lock()
        text = open(here).read() if os.path.exists(here) else on(host, ["bin/hourly", "brief", sid]).stdout
        hosts = all_facts(full=False)
        p = pool_at(hosts, host, sid, text)
        why = pr.pool_wait(p, slots(hosts), unknown(hosts)) or (paused(hosts, host) if p == "auto" else "")
        if why:
            print(f"wait {host} {sid}: {why}")
            log(host, "wait", sid, f"{why}; {reason}")
            return 3
    p = on(host, ["bin/hourly", "recv", sid, *(["--drain"] if drain else [])], stdin=open(here).read() if send else "",
           env={} if drain else {"PI_RUN_COUNTED": "1"})
    lock is None or os.close(lock)
    sys.stdout.write(p.stdout)
    sys.stderr.write(p.stderr)
    if p.returncode == 0:
        role = p.stdout.rsplit(" as role ", 1)[-1].split(":")[0] if " as role " in p.stdout else "?"
        log(host, "resume" if "pi-run: resumed " in p.stdout else "launch", sid, f"{role}; {reason}")
    return p.returncode


def drain():
    dry = bool(os.environ.get("PI_RUN_DRY"))
    if not dry:
        os.makedirs(root(), exist_ok=True)
        lock = os.open(os.path.join(root(), "hourly-queue.lock"), os.O_RDWR | os.O_CREAT, 0o644)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            pr.die(3, "queue: another hourly queue pass is running; nothing launched")
        slots_lock()
    hosts = all_facts()
    errors = []
    reopen(hosts, merge_waits(errors), dry)
    for e in errors:
        print(f"error: {e}: no red PR was reopened this pass")
    hosts = all_facts() if not dry else hosts
    n = slots(hosts)
    blind = unknown(hosts)
    for h in blind:
        print(f"host {h}: runs unknown, so every queue waits: {hosts[h]['error'] if h in hosts else 'this host cannot read it'}")
    for h in hosts:
        if pause := paused(hosts, h):
            print(f"pause: {pause}")
    queued = sorted((r.get("since", ""), h, sid, r["pool"]) for h, f in hosts.items() for sid, r in f.get("runs", {}).items()
                    if r["state"] == "queued")
    rc = 0
    for since, h, sid, p in queued:
        f = hosts[h]
        r = f["runs"][sid]
        why = f"after a 429, not before resume_at {r['resume_at']}" if waiting(r) else pr.pool_wait(p, n, blind) or \
            (paused(hosts, h) if p == "auto" else "") or \
            ("not at main" if h != SELF and not f["at_main"] else f"{f['free_gb']}G free, under {FLOOR_GB}G" if h != SELF and
             f["free_gb"] < FLOOR_GB else "")
        if why:
            print(f"wait {h} {sid}: {why}; queued since {since}")
            dry or log(h, "wait", sid, f"{why}; queued since {since}")
        elif dry:
            print(f"would launch {h} {sid}: {p} pool, queued since {since}")
            n[p] += 1
        elif launch(sid, h, "chat queue", send=False, drain=True) == 0:
            n[p] += 1
        else:
            rc = 1
    free = 0 if blind else max(0, pr.conf("slots")["auto"] - n["auto"])
    print(f"queue: {len(queued)} queued, slots now {slots_line(n)}: auto free {free}")
    return rc


def write(p, obj):
    with open(p + ".tmp", "w") as f:
        json.dump(obj, f, indent=1)
    os.replace(p + ".tmp", p)


def main(argv):
    print(f"zstack {pr.sha()}", file=sys.stderr)
    cmd = argv[0] if argv and not argv[0].startswith("--") else "pass"
    rest = argv[1:] if cmd != "pass" else argv
    if cmd in ("pass", "done"):
        if cmd == "pass":
            pr.on_main(argv, __file__)
        linear = [x for x in rest[1].split(",") if x.strip()] if rest[:1] == ["--linear"] and len(rest) > 1 else []
        s, fpath = snapshot(linear), os.path.join(root(), "hourly-fingerprint.json")
        fp, last = fingerprint(s), json.load(open(fpath)) if os.path.exists(fpath) else {}
        write(os.path.join(root(), "hourly-snapshot.json"), {"ts": now(), **s})
        if cmd == "done":
            write(fpath, {"ts": now(), "fp": fp})
            return print(f"hourly done: fingerprint {fp} stored") or 0
        free = auto_free(s["hosts"])
        acts = s["batch_due"] or s["errors"] or (s["merge"] or ["ok"])[0] != "ok" or (free and s["linear"]) or \
            any("error" in f or any(due(r, h) for r in f.get("runs", {}).values()) for h, f in s["hosts"].items())
        skip = fp == last.get("fp") and not acts
        log(SELF, "pass", "-", f"candidates {len(s['linear'])} todo, auto free {free}{', skip: nothing changed' if skip else ''}")
        if skip:
            return print(f"skip: nothing changed since {last['ts']} (fingerprint {fp})") or 0
        return report(s, fp, last) or 0
    if cmd == "facts" and rest in ([], ["--runs"]):
        return print(json.dumps(facts(not rest))) or 0
    if cmd == "brief" and len(rest) == 1 and pr.ID.fullmatch(rest[0]):
        p = os.path.join(root(), "review", rest[0], "brief.md")
        return print(open(p).read() if os.path.exists(p) else "", end="") or 0
    if cmd == "pools" and not rest:
        hosts = all_facts(full=False)
        return print(json.dumps({"running": slots(hosts), "unknown": unknown(hosts)})) or 0
    if cmd == "log" and len(rest) >= 4:
        return log(rest[0], rest[1], rest[2], " ".join(rest[3:])) or 0
    if cmd == "on" and len(rest) >= 2:
        p = on(rest[0], rest[1:])
        sys.stdout.write(p.stdout)
        sys.stderr.write(p.stderr)
        return p.returncode
    if cmd == "launch" and len(rest) >= 3 and pr.ID.fullmatch(rest[0]):
        return launch(rest[0], rest[1], " ".join(rest[2:]))
    if cmd == "queue" and not rest:
        return drain()
    if cmd == "recv" and len(rest) in (1, 2) and pr.ID.fullmatch(rest[0]) and rest[1:] in ([], ["--drain"]):
        d = os.path.join(root(), "review", rest[0])
        brief, text = os.path.join(d, "brief.md"), sys.stdin.read()
        if text and os.path.exists(brief) and open(brief).read() != text:
            pr.die(3, f"{rest[0]}: review/{rest[0]}/brief.md here differs from the brief sent")
        if text:
            os.makedirs(d, exist_ok=True)
            with open(brief, "w") as f:
                f.write(text)
        if not os.path.exists(brief):
            pr.die(2, f"{rest[0]}: no review/{rest[0]}/brief.md on {SELF}; write it with bin/new-brief")
        text = open(brief).read()
        queued = (pr.read_json(os.path.join(d, "run.json")) or {}).get("role")
        role = pr.field(text, "role", queued or "coding")
        env = {**os.environ, "PI_RUN_DRAIN": "1"} if rest[1:] == ["--drain"] else {k: v for k, v in os.environ.items() if k != "PI_RUN_DRAIN"}
        os.execve(os.path.join(PKG, "bin", "pi-run"), ["pi-run", rest[0], role, brief], env)
    if cmd == "report" and len(rest) == 1 and pr.ID.fullmatch(rest[0]):
        d = os.path.join(root(), "review", rest[0])
        p = os.path.join(d, "report.md")
        if not os.path.exists(p) and not os.path.exists(os.path.join(d, "run.log")):
            pr.die(2, f"{rest[0]}: no report.md or run.log in review/{rest[0]} on {SELF}")
        lines = open(p if os.path.exists(p) else os.path.join(d, "run.log"), errors="replace").read().splitlines()
        return print("\n".join(x for x in (lines if os.path.exists(p) else lines[-80:]) if "TOKEN" not in x)) or 0
    pr.die(2, USAGE)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
