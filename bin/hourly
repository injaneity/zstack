#!/usr/bin/env python3
"""hourly: the facts and bookkeeping of the onigiri hourly pass. The pass itself is skills/onigiri-mode/playbooks/hourly.md.

  hourly [--linear CUA-1,CUA-2]   STEP 0: this host's and its peers' runs, slots, launch host and the fingerprint.
                                  Prints one `skip:` line and nothing else when nothing changed since `hourly done`.
  hourly done [--linear ...]      after the pass: store the fingerprint and the snapshot status answers come from
  hourly log <host> <action> <item> <reason...>   append one pickup.log row (ts_sgt host action item reason free_gb)
  hourly launch <id> <host> <reason...>           start review/<id>/brief.md on <host>, then log the launch
  hourly queue                    first reopen the thread that pushed each of our PRs red after the merge job's rerun
                                  (bin/pi-run ci on its host), then start every host's queued runs on that host,
                                  oldest since= first, while slots are free: fresh ones, and continuations (a 429's,
                                  a red PR's) in their own session once resume_at has passed (PI_RUN_DRY=1: plan only)
  hourly on <host> <package path> [args...]       run this package's file (bin/pi-run, hosts/vm/merge_job.py) there
  hourly report <id>              the run's report.md, else the end of its run.log, with TOKEN lines dropped
  hourly facts | recv <id> [--drain]  what a peer is asked for over `on`: this host's facts as JSON; a brief on stdin
                                  (--drain: the queue drain's start, the only one that may resume a 429'd run)

The host running it is $ONIGIRI_HOST, else ~/.config/onigiri/host (hosts/<name>/host.sh, as bin/pi-run); its peers are
$ONIGIRI_PEERS, `name=<command>` words where <command> runs one shell line on the peer (the mini's is the VM's ssh
wrapper). $ONIGIRI_MERGE_HOST names the host that runs hosts/vm/merge_job.py: a report runs its --dry-run there and
prints each PR it waits on with who=zane under needs-Zane and who=session under unstick, and its tick/last-run says
whether the job is ok, stale, not ok or paused. The host file's env is this process's, so gh resolves. pickup.log and the fingerprint
live in this host's $ONIGIRI_ROOT. The pass first moves the package to origin/main, like bin/pi-run.
"""
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from datetime import datetime
from zoneinfo import ZoneInfo

PKG = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
_l = importlib.machinery.SourceFileLoader("pi_run", os.path.join(PKG, "bin", "pi-run"))
pr = importlib.util.module_from_spec(importlib.util.spec_from_loader(_l.name, _l))
_l.exec_module(pr)
SGT = ZoneInfo("Asia/Singapore")
FLOOR_GB, HUNG_MIN = 20, 180   # the VM floor and the hung mark: the routine's rules (playbooks/hourly.md)
_slots = json.load(open(os.path.join(PKG, "config", "slots.json")))   # the one copy of the shared caps
TOTAL, AUTO = int(_slots["total"]), int(_slots["auto"])
MERGE_STALE_MIN = 15 + 40   # the merge job's cron interval plus its kill limit (docs/HOST.md)
# merge_job.py's last-run: `<iso ts> zstack <sha> ok|<n> error(s)[ paused]`
LAST_RUN = re.compile(r"(\S+) zstack (?:[0-9a-f]{40}|unknown) (ok|\d+ error\(s\))( paused)?")
SELF = pr.host_name() or "local"   # the name pickup.log rows and `on` use for this host
PEER_PKG = ".pi/agent/git/github.com/injaneity/zstack"   # where `pi install git:github.com/injaneity/zstack` puts it
HEAD = "# onigiri hourly pickup decisions, append-only. one line per decision, tab-separated:\n# ts_sgt\thost\taction\titem\treason\tfree_gb\n"


def now():
    return datetime.now(SGT).isoformat(timespec="minutes")


HOST = []


def root():
    """This host's $ONIGIRI_ROOT, from its host file like bin/pi-run's. The host file's env (PATH, GH_CONFIG_DIR) becomes
    this process's too, so gh and the peer's command resolve from any shell, as a launch from bin/pi-run does."""
    if not HOST:
        HOST.extend(pr.host_env("list"))
        os.environ.update(HOST[0])
    return HOST[1].rsplit("/review", 1)[0]


def peers():
    """$ONIGIRI_PEERS from the host file: {name: command that runs one shell line there}."""
    root()
    return dict(w.split("=", 1) for w in HOST[0].get("ONIGIRI_PEERS", "").split() if "=" in w)


def run(cmd, **kw):
    """A command that is not installed is a failed result naming it, never a traceback."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, **kw)
    except FileNotFoundError:
        return subprocess.CompletedProcess(cmd, 127, "", f"{cmd[0]}: not found on PATH (set it in the host file)\n")


def on(host, args, stdin=None):
    """Run a package file on `host`: here when it is this host, else through the peer's command."""
    if host == SELF:
        return run([os.path.join(PKG, args[0]), *args[1:]], input=stdin)
    if host not in peers():
        pr.die(2, f"no host {host}: this is {SELF}, peers {' '.join(peers()) or 'none'}")
    line = f"ONIGIRI_HOST={shlex.quote(host)} ~/{PEER_PKG}/{shlex.quote(args[0])} " + " ".join(map(shlex.quote, args[1:]))
    return run([*shlex.split(peers()[host]), line], input=stdin)


def activity_min(d):
    """Minutes since the run's log or its pi session last changed: a running run idle this long may be hung."""
    agent = os.environ.get("PI_CODING_AGENT_DIR") or os.path.expanduser("~/.pi/agent")
    sess = os.path.join(agent, "sessions", "--" + d.strip("/").replace("/", "-") + "--")
    paths = [os.path.join(d, "run.log")] + [os.path.join(sess, f) for f in (os.listdir(sess) if os.path.isdir(sess) else [])]
    return int((time.time() - max([os.path.getmtime(p) for p in paths if os.path.exists(p)] or [0])) // 60)


def facts():
    """This host: zstack sha and parity, free disk, and every run not collected."""
    r, ls = root(), run([os.path.join(PKG, "bin", "pi-run"), "list"])
    if ls.returncode:   # runs unknown: report the host as an error, which every pass and the queue treat as unknown slots
        return {"error": "pi-run list: " + (ls.stderr.strip().splitlines() or [f"exit {ls.returncode}"])[-1][:200]}
    out = ls.stdout
    parity = run([os.path.join(PKG, "hosts", "check-parity")], env={**os.environ, "ONIGIRI_ROOT": r})
    runs = {}
    for line in out.splitlines():
        sid, state, *kv = line.split()
        if state == "collected":
            continue
        d, f = os.path.join(r, "review", sid), dict(x.split("=", 1) for x in kv)
        brief = open(os.path.join(d, "brief.md"), errors="replace").read() if os.path.exists(os.path.join(d, "brief.md")) else ""
        f.update(state=state, auto="source: auto" in brief.splitlines() or "uto-picked" in brief)
        if state == "running":
            f["idle_min"] = activity_min(d)
        runs[sid] = f
    last = os.path.join(r, "tick", "last-run")   # the merge job's host only: its last finished run
    try:
        merge = {"merge_last": open(last, errors="replace").read().strip()} if os.path.exists(last) else {}
    except OSError as e:
        merge = {"merge_last": f"unreadable: {e}"}
    return {"sha": pr.sha(), "at_main": parity.returncode == 0, "parity": [x for x in parity.stdout.splitlines() if x.startswith("FAIL")],
            "free_gb": free_gb(r), "runs": runs, "pushed": pushed(os.path.join(r, "review")), **merge}


def pushed(review):
    """{"<sha> <branch>": [id, utc time]} from every review/<id>/pushed (cua's pre-push hook writes `<sha> <branch> <utc time>`
    per ref pushed to trycua/cua): the run that pushed each head to each branch last."""
    rows = []
    for sid in sorted(os.listdir(review)) if os.path.isdir(review) else []:
        if os.path.isfile(p := os.path.join(review, sid, "pushed")):
            rows += [(f[2], f"{f[0]} {f[1]}", sid) for f in (x.split() for x in open(p, errors="replace"))
                     if len(f) == 3 and re.fullmatch(r"[0-9a-f]{40}", f[0])]
    return {key: [sid, at] for at, key, sid in sorted(rows)}


RED = re.compile(r"cua#(\d+) ([0-9a-f]{7,40}) wait who=session: (red after rerun: .*)")


def owners(hosts, waits, branch_of):
    """[(pr, full head, host, id, why)] for each merge-job wait that is our PR red after its rerun, with the run that last
    pushed that head to the PR's own branch, on any host; a head no run pushed there (by hand, or before the hook recorded
    pushes) is (pr, head, None, None, why). branch_of(pr) is the PR's (head sha, branch) from GitHub. A push of a PR's
    current head to its own branch is up to date, so git hands the hook no ref line for it and a rejected later attempt
    cannot take the head over."""
    out = []
    for w in waits:
        if not (m := RED.fullmatch(w)):
            continue
        gh = branch_of(m[1])
        hit = sorted((at, key.split()[0], h, sid) for h, f in hosts.items() for key, (sid, at) in (f.get("pushed") or {}).items()
                     if key.startswith(m[2]) and key == f"{gh[0]} {gh[1]}")
        _, sha, h, sid = hit[-1] if hit else (None, gh[0], None, None)
        out.append((m[1], sha, h, sid, m[3]))
    return out


def branch_of(n):
    """(head sha, head branch) of trycua/cua#n now, or ("unknown", "unknown") when GitHub cannot say."""
    p = run(["gh", "pr", "view", n, "-R", "trycua/cua", "--json", "headRefOid,headRefName"])
    try:
        d = json.loads(p.stdout) if not p.returncode else {}
    except ValueError:
        d = {}
    d = d if isinstance(d, dict) else {}
    return (d["headRefOid"], d["headRefName"]) if d.get("headRefOid") and d.get("headRefName") else ("unknown", "unknown")


def reopen(hosts, waits, dry):
    """Give each red PR back to the thread that pushed its head (bin/pi-run ci on that host). One with no such thread, or
    whose thread has spent its fix attempts, is printed for the pass: an unstick to file, or a needs-Zane item."""
    for n, sha, h, sid, why in owners(hosts, waits, branch_of):
        if sha == "unknown":
            print(f"red cua#{n}: gh pr view failed, so its thread is unknown this pass")
            continue
        if sid is None:
            print(f"red cua#{n} {sha[:9]}: no run pushed this head; file an unstick")
            continue
        if dry:
            print(f"would reopen {h} {sid} for cua#{n} at {sha[:9]}: {why}")
            continue
        p = on(h, ["bin/pi-run", "ci", sid, n, sha, why])
        if p.returncode == 0:
            print(f"reopen {h} {sid}: {p.stdout.strip()}")
            log(h, "ci-reopen", sid, f"cua#{n} at {sha[:9]}: {why}")
        else:
            err = (p.stderr.strip().splitlines() or [f"exit {p.returncode}"])[-1].removeprefix("pi-run: ")
            print(f"red cua#{n} {sha[:9]}: {err}" + ("; needs Zane" if "spent" in err else ""))


def free_gb(p):
    """Free GiB on the disk that holds p; a root not made yet is on its nearest existing parent's disk."""
    p = os.path.abspath(p)
    while not os.path.exists(p):
        p = os.path.dirname(p)
    return shutil.disk_usage(p).free // 2**30


def batch_due(r):
    """The daily preapprove batch: due from 08:00 SGT until a pickup.log row records today's."""
    t = datetime.now(SGT)
    rows = open(os.path.join(r, "pickup.log")).read().splitlines() if os.path.exists(os.path.join(r, "pickup.log")) else []
    done = any(x.startswith(t.date().isoformat()) and x.split("\t")[2:3] in (["preapprove-batch"], ["step9"]) for x in rows)
    return t.hour >= 8 and not done


def all_facts():
    hosts = {SELF: facts()}
    for h in peers():
        p = on(h, ["bin/hourly", "facts"])
        try:
            hosts[h] = json.loads(p.stdout)
        except ValueError:
            hosts[h] = {"error": (p.stderr.strip().splitlines() or [f"exit {p.returncode}"])[-1][:200]}
    return hosts


def slots(hosts):
    """(running, auto running) across every host: the total and auto slots (config/slots.json) are shared. Only a running
    run holds one: a run that hit a 429 is queued again and gave its slot back."""
    rs = [r for f in hosts.values() for r in f.get("runs", {}).values() if r["state"] == "running"]
    return len(rs), sum(r["auto"] for r in rs)


def auto_free(hosts):
    """Auto slots an hourly pick may take now: the auto cap less auto runs, never past the total's free slots. None while
    a host is unreachable: its runs are unknown, so no slot is known free (the drain's rule). model/Hourly.tla CapsHold."""
    if any("error" in f for f in hosts.values()):
        return 0
    running, auto = slots(hosts)
    return max(0, min(TOTAL - running, AUTO - auto))


def snapshot(linear):
    hosts = all_facts()
    def gh(*a):
        p = run(["gh", "pr", "list", "-R", "trycua/cua", "--state", "open", "--limit", "2000", *a])
        if p.returncode:
            errors.append(f"gh pr list {a[0]} {a[1]}: " + (p.stderr.strip().splitlines() or [f"exit {p.returncode}"])[-1][:150])
        return json.loads(p.stdout) if not p.returncode and p.stdout.strip() else []
    errors = []
    ours = gh("--author", "injaneity", "--json", "number,headRefOid")
    others = gh("--search", "-author:injaneity", "--json", "number,author")
    bot = lambda a: a.get("is_bot") or a["login"].startswith("app/") or a["login"].endswith("[bot]")  # noqa: E731
    waits = merge_waits(errors)
    mh = HOST[0].get("ONIGIRI_MERGE_HOST")
    return {"hosts": hosts, "linear": sorted(linear), "batch_due": batch_due(root()), "errors": errors, "waits": waits,
            "merge": merge_health(hosts[mh].get("merge_last")) if mh in hosts and "error" not in hosts[mh] else None,
            "ours": sorted(f"{p['number']}:{p['headRefOid'][:9]}" for p in ours),   # a push to ours is work: merge, unstick
            "others": sorted(f"{p['number']}:{p['author']['login']}" for p in others if not bot(p["author"]))}   # new or closed


def merge_health(line):
    """(status, the merge job's last-run line with its age). Stale: no run finished within one 15-minute interval plus
    its 40-minute kill (docs/HOST.md's cron line), so the job is not running."""
    if not line:
        return "no last-run", "no tick/last-run on the merge host"
    m = LAST_RUN.fullmatch(line)
    try:
        age = int((time.time() - datetime.fromisoformat(m[1]).timestamp()) // 60) if m else None
    except ValueError:
        age = None
    if age is None or age < -5:   # not merge_job.py's line, or a clock it cannot have written: never trusted as ok
        return "unreadable", line
    state = "paused" if m[3] else "not ok" if m[2] != "ok" else "stale" if age > MERGE_STALE_MIN else "ok"
    return state, f"{line} ({age}m ago)"


def waiting(r):
    """A queued run that hit a 429 and may not start before its resume_at."""
    return r["state"] == "queued" and r.get("resume_at", "") > pr.utc()


def due(f, h):
    return f["state"] in ("exited", "lost") or (f["state"] == "queued" and not waiting(f)) or f.get("idle_min", 0) >= HUNG_MIN


def fingerprint(s):
    """What a pass acts on: run states, parity, the floor, PR heads, Linear Todo, the batch. Not ages or exact disk."""
    keep = {h: {"runs": {k: (v["state"], v.get("idle_min", 0) >= HUNG_MIN) for k, v in f.get("runs", {}).items()},
                "at_main": f.get("at_main"), "floor": f.get("free_gb", 0) >= FLOOR_GB, "error": "error" in f}
            for h, f in s["hosts"].items()}
    return hashlib.sha256(json.dumps([keep, s["linear"], s["ours"], s["others"], s["batch_due"], s["waits"],
                                      (s.get("merge") or [None])[0]],
                                     sort_keys=True).encode()).hexdigest()[:16]


def report(s, fp, last):
    print(f"hourly {now()} fingerprint {fp} (last {last.get('fp', 'none')} at {last.get('ts', 'never')})")
    running, auto = slots(s["hosts"])
    for h, f in s["hosts"].items():
        if "error" in f:
            print(f"host {h}: unreachable: {f['error']}")
            continue
        print(f"host {h}: zstack {f['sha'][:9]} {'at main' if f['at_main'] else 'NOT at main: ' + '; '.join(f['parity'])}, free {f['free_gb']}G")
        for sid, r in sorted(f["runs"].items(), key=lambda x: (x[1]["state"], x[1].get("since", ""))):
            extra = " ".join(f"{k}={r[k]}" for k in ("rc", "since", "resume_at", "idle_min") if k in r and r[k] != "None")
            print(f"  {r['state']:<8} {sid} {'auto ' if r['auto'] else ''}{extra}{'  HUNG?' if r.get('idle_min', 0) >= HUNG_MIN else ''}")
    vm = [h for h, f in s["hosts"].items() if h != SELF and f.get("at_main") and f.get("free_gb", 0) >= FLOOR_GB]
    print(f"slots: running {running}/{TOTAL}, auto {auto}/{AUTO}: free {max(0, TOTAL - running)}, auto {auto_free(s['hosts'])}")
    print(f"launch host: {vm[0] if vm else SELF} (a peer only at main with {FLOOR_GB}G free)")
    for e in s["errors"]:
        print(f"error: {e}: the PR lists are unknown this pass")
    todo = f"{len(s['linear'])}: {','.join(s['linear']) or 'none passed'}"
    print(f"prs: ours {len(s['ours'])} open, others {len(s['others'])} open; linear todo {todo}")
    print(f"preapprove batch: {'due' if s['batch_due'] else 'not due'}")
    if s.get("merge"):
        print(f"merge job: {s['merge'][0]}: {s['merge'][1]}")
    for head, who in (("needs-Zane", "zane"), ("unstick", "session")):
        hits = [x for x in s["waits"] if f" wait who={who}: " in x]
        print(f"merge job {head}: {len(hits) or 'none'}")
        own = {f"cua#{n} {sha[:9]}": f"{sid} on {h}" for n, sha, h, sid, _ in owners(s["hosts"], hits, branch_of) if sid}
        for x in hits:
            mine = own.get(" ".join(x.split()[:2]))
            print(f"  {x.replace(f' wait who={who}', '')}" + (f"  (thread {mine}: bin/hourly queue reopens it)" if mine else ""))
    print(f"next: {os.path.join(PKG, 'skills', 'onigiri-mode', 'playbooks', 'hourly.md')}")


def merge_waits(errors):
    """The merge job's --dry-run on $ONIGIRI_MERGE_HOST: its `<id> <head> wait who=<zane|session>: <why>` lines, sorted.
    They are in the fingerprint, so a PR that goes red after its rerun at the same head is still news."""
    root()
    h = HOST[0].get("ONIGIRI_MERGE_HOST")
    if not h:
        return []
    p = on(h, ["hosts/vm/merge_job.py", "--dry-run"])
    if p.returncode:
        errors.append(f"merge job dry run on {h}: " + (p.stderr.strip().splitlines() or [f"exit {p.returncode}"])[-1][:150])
    return sorted(x.split(" ", 1)[1] for x in p.stdout.splitlines() if x.startswith("dry-run ") and " wait who=" in x)


def log(host, action, item, reason):
    """One pickup.log row; free_gb is the host's from this pass's snapshot (this host's is read now)."""
    try:
        free = json.load(open(os.path.join(root(), "hourly-snapshot.json")))["hosts"][host]["free_gb"]
    except (OSError, ValueError, KeyError):
        free = "-"
    free = shutil.disk_usage(root()).free // 2**30 if host == SELF else free
    with open(os.path.join(root(), "pickup.log"), "a") as f:
        f.write((HEAD if not f.tell() else "") + "\t".join([now(), host, action, item, " ".join(reason.split()), str(free)]) + "\n")


def launch(sid, host, reason, send=True, drain=False):
    """Start review/<id>/brief.md on `host` and log it. With `send`, a brief here goes to a peer host; else the host's own is
    read. Only the queue drain (`drain`) may resume a 429'd run."""
    here = os.path.join(root(), "review", sid, "brief.md")
    send = send and host != SELF and os.path.exists(here)
    p = on(host, ["bin/hourly", "recv", sid, *(["--drain"] if drain else [])], stdin=open(here).read() if send else "")
    sys.stdout.write(p.stdout)
    sys.stderr.write(p.stderr)
    if p.returncode == 0:
        role = p.stdout.rsplit(" as role ", 1)[-1].split(":")[0] if " as role " in p.stdout else "?"
        log(host, "resume" if "pi-run: resumed " in p.stdout else "launch", sid, f"{role}; {reason}")
    return p.returncode


def drain():
    """Every host's queue the same way: its queued runs start on that host, oldest since= first across all hosts, while the
    shared slots allow (an auto brief also needs an auto slot), and a peer only at main with the floor free (playbook step 3).
    A run back from a 429 keeps its first since= and waits for its resume_at, then resumes in its own session. One that
    cannot start yet gets a `wait` row. PI_RUN_DRY=1 prints the plan and launches and logs nothing."""
    dry = bool(os.environ.get("PI_RUN_DRY"))
    if not dry:   # two passes counting the same free slot would both fill it; the lock is held until exit
        os.makedirs(root(), exist_ok=True)
        lock = os.open(os.path.join(root(), "hourly-queue.lock"), os.O_RDWR | os.O_CREAT, 0o644)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            pr.die(3, "queue: another hourly queue pass is running; nothing launched")
    hosts = all_facts()
    errors = []
    reopen(hosts, merge_waits(errors), dry)
    for e in errors:
        print(f"error: {e}: no red PR was reopened this pass")
    hosts = all_facts() if not dry else hosts
    running, auto = slots(hosts)
    blind = [h for h, f in hosts.items() if "error" in f]   # its running runs are unknown, so no slot is known free
    for h in blind:
        print(f"host {h}: runs unknown, so every queue waits: {hosts[h]['error']}")
    queued = sorted((r.get("since", ""), h, sid, r["auto"]) for h, f in hosts.items() for sid, r in f.get("runs", {}).items()
                    if r["state"] == "queued")
    rc = 0
    for since, h, sid, is_auto in queued:
        f = hosts[h]
        r = f["runs"][sid]
        why = f"after a 429, not before resume_at {r['resume_at']}" if waiting(r) else \
            f"{', '.join(blind)} runs unknown" if blind else \
            f"slots full: running {running}/{TOTAL}, auto {auto}/{AUTO}" if running >= TOTAL or (is_auto and auto >= AUTO) else \
            "not at main" if h != SELF and not f["at_main"] else f"{f['free_gb']}G free, under {FLOOR_GB}G" if h != SELF and \
            f["free_gb"] < FLOOR_GB else ""
        if why:
            print(f"wait {h} {sid}: {why}; queued since {since}")
            dry or log(h, "wait", sid, f"{why}; queued since {since}")
        elif dry:
            print(f"would launch {h} {sid}: queued since {since}")
            running, auto = running + 1, auto + is_auto
        elif launch(sid, h, "chat queue", send=False, drain=True) == 0:
            running, auto = running + 1, auto + is_auto
        else:
            rc = 1
    print(f"queue: {len(queued)} queued, slots now running {running}/{TOTAL}, auto {auto}/{AUTO}")
    return rc


def write(p, obj):
    with open(p + ".tmp", "w") as f:
        json.dump(obj, f, indent=1)
    os.replace(p + ".tmp", p)


def main(argv):
    print(f"zstack {pr.sha()}", file=sys.stderr)
    cmd = argv[0] if argv and not argv[0].startswith("--") else "pass"
    rest = argv[1:] if cmd != "pass" else argv
    if cmd in ("pass", "done"):
        if cmd == "pass":
            pr.on_main(argv, __file__)
        linear = [x for x in rest[1].split(",") if x.strip()] if rest[:1] == ["--linear"] and len(rest) > 1 else []
        s, fpath = snapshot(linear), os.path.join(root(), "hourly-fingerprint.json")
        fp, last = fingerprint(s), json.load(open(fpath)) if os.path.exists(fpath) else {}
        write(os.path.join(root(), "hourly-snapshot.json"), {"ts": now(), **s})   # status answers read the last one
        if cmd == "done":
            write(fpath, {"ts": now(), "fp": fp})
            return print(f"hourly done: fingerprint {fp} stored") or 0
        free = auto_free(s["hosts"])
        acts = s["batch_due"] or s["errors"] or (s["merge"] or ["ok"])[0] != "ok" or (free and s["linear"]) or \
            any("error" in f or any(due(r, h) for r in f.get("runs", {}).values()) for h, f in s["hosts"].items())
        skip = fp == last.get("fp") and not acts
        # every pass, skipped or not, leaves its candidate count, so a pass that picked nothing still shows in pickup.log
        log(SELF, "pass", "-", f"candidates {len(s['linear'])} todo, auto free {free}{', skip: nothing changed' if skip else ''}")
        if skip:
            return print(f"skip: nothing changed since {last['ts']} (fingerprint {fp})") or 0
        return report(s, fp, last) or 0
    if cmd == "facts":
        return print(json.dumps(facts())) or 0
    if cmd == "log" and len(rest) >= 4:
        return log(rest[0], rest[1], rest[2], " ".join(rest[3:])) or 0
    if cmd == "on" and len(rest) >= 2:
        p = on(rest[0], rest[1:])
        sys.stdout.write(p.stdout)
        sys.stderr.write(p.stderr)
        return p.returncode
    if cmd == "launch" and len(rest) >= 3 and pr.ID.fullmatch(rest[0]):
        return launch(rest[0], rest[1], " ".join(rest[2:]))
    if cmd == "queue" and not rest:   # each launch's bin/pi-run moves its host's package to main first
        return drain()
    if cmd == "recv" and len(rest) in (1, 2) and pr.ID.fullmatch(rest[0]) and rest[1:] in ([], ["--drain"]):
        d = os.path.join(root(), "review", rest[0])
        brief, text = os.path.join(d, "brief.md"), sys.stdin.read()
        if text and os.path.exists(brief) and open(brief).read() != text:
            pr.die(3, f"{rest[0]}: review/{rest[0]}/brief.md here differs from the brief sent")
        if text:
            os.makedirs(d, exist_ok=True)
            with open(brief, "w") as f:
                f.write(text)
        if not os.path.exists(brief):
            pr.die(2, f"{rest[0]}: no review/{rest[0]}/brief.md on {SELF}; write it with bin/new-brief")
        text = open(brief).read()
        queued = (pr.read_json(os.path.join(d, "run.json")) or {}).get("role")
        role = next((x.split(":", 1)[1].strip() for x in text.splitlines() if x.startswith("role:")), queued or "coding")
        env = {**os.environ, "PI_RUN_DRAIN": "1"} if rest[1:] == ["--drain"] else {k: v for k, v in os.environ.items() if k != "PI_RUN_DRAIN"}
        os.execve(os.path.join(PKG, "bin", "pi-run"), ["pi-run", rest[0], role, brief], env)
    if cmd == "report" and len(rest) == 1 and pr.ID.fullmatch(rest[0]):
        d = os.path.join(root(), "review", rest[0])
        p = os.path.join(d, "report.md")
        if not os.path.exists(p) and not os.path.exists(os.path.join(d, "run.log")):
            pr.die(2, f"{rest[0]}: no report.md or run.log in review/{rest[0]} on {SELF}")
        lines = open(p if os.path.exists(p) else os.path.join(d, "run.log"), errors="replace").read().splitlines()
        return print("\n".join(x for x in (lines if os.path.exists(p) else lines[-80:]) if "TOKEN" not in x)) or 0
    pr.die(2, __doc__.split("\n\n")[1])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
