#!/usr/bin/env python3
"""policy: the one reader of zstack's declarative files in config/: policy.toml (values the code reads: models, slots,
gates, the patent hold, the pickup), rules.toml (the Hard rules every session runs under) and state.toml (the runtime
state files on a host, each with its one writer and its readers).

  policy check          parse and validate all three: one line, exit 1 when one is not valid
  policy get <key>      one policy.toml value by dotted key (`slots.hand`, `models.designer`): a string or number as is, else JSON
  policy dump           policy.toml as JSON, for readers that are not Python (the subagent extension, rule-guard)
  policy rules          the Hard rules as the markdown bin/pi-run appends to every session's system prompt
  policy rules <id>...  only the named rules, one bullet each, for an agent whose agents/<name>.md lists them (`rules:`)

Python readers load this file as a module and call load(), rules() or state(), which return the validated data or raise
PolicyError. Every key is declared in a schema: an unknown key, a missing one or a wrong type is an error, never a
default, so a typo cannot drop a rule without a word. The per-PR hold and preapprove rows are not config: they are the
merge host's ledger, hold-prs.txt, a state file state.toml names (docs/HOST.md, Holds file). Runs on python3 3.9 or
newer: 3.11 has tomllib, and older ones get vendor/tomli, the pinned upstream tomllib was copied from, because the mini's
/usr/bin/python3 is 3.9 and cron or a bare shell runs it.
"""
import json
import os
import re
import sys

PKG = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
try:
    import tomllib
except ModuleNotFoundError:
    sys.path.insert(0, os.path.join(PKG, "vendor"))
    import tomli as tomllib
PATH = os.path.join(PKG, "config", "policy.toml")
RULES = os.path.join(PKG, "config", "rules.toml")
STATE = os.path.join(PKG, "config", "state.toml")


class PolicyError(Exception):
    pass


def pos_int(v):
    return type(v) is int and v > 0


def seat(v):
    return isinstance(v, dict) and set(v) == {"provider", "model"} and all(isinstance(x, str) and x.strip() for x in v.values())


def names(v):
    """A list of distinct non-empty strings (it may be empty)."""
    return isinstance(v, list) and all(isinstance(x, str) and x.strip() for x in v) and len(set(v)) == len(v)


def words(v):
    """Distinct lowercase words: the merge job builds its risk regex from them, so nothing else may appear."""
    return names(v) and all(re.fullmatch(r"[a-z]+", x) for x in v)


def repo(v):
    return isinstance(v, str) and v.count("/") == 1 and all(v.split("/"))


def seats(v):
    """One seat, or a non-empty list of them: a role run as a race has one seat per side (the designers)."""
    return seat(v) or isinstance(v, list) and bool(v) and all(seat(x) for x in v)


# Each section: {key: (check, what it must be)}. Every key is required and no other is allowed: [models] names exactly
# the roles bin/pi-run launches and the agents in agents/, so a misspelt verifier is an error, not a child that runs
# on the parent's model.
SEAT = (seats, "a {provider, model} table or a non-empty list of them")
SCHEMA = {
    "models": {role: SEAT for role in ("coding", "research", "explorer", "designer", "verifier")},
    "slots": {"auto": (pos_int, "a positive integer"), "hand": (pos_int, "a positive integer")},
    "ci": {"fix_attempts": (pos_int, "a positive integer")},
    "resume": {"cap": (pos_int, "a positive integer")},
    "run": {"idle_min": (pos_int, "a positive integer")},
    "patent": {
        "held_words": (lambda v: words(v) and bool(v), "a non-empty list of distinct lowercase words"),
        "skip_lockfiles": (lambda v: names(v) and bool(v) and not any("/" in x for x in v), "a non-empty list of distinct file names"),
        "public_repo": (repo, "owner/name"),
        "private_repo": (repo, "owner/name"),
    },
    "people": {"me": (lambda v: isinstance(v, str) and v.strip() != "", "a GitHub login")},
    "hourly": {
        "floor_gb": (pos_int, "a positive integer"),
        "merge_stale_min": (pos_int, "a positive integer"),
        "batch_hour": (lambda v: type(v) is int and 0 <= v <= 23, "an hour of the day, 0 to 23"),
        "file_cap": (pos_int, "a positive integer"),
        "lume_prune_age_h": (pos_int, "a positive integer"),
    },
    "pickup": {
        "interval_s": (pos_int, "a positive integer"),
        "deadline_s": (pos_int, "a positive integer"),
        "label_hosts": (lambda v: isinstance(v, dict) and all(isinstance(x, str) and x.strip() for x in [*v, *v.values()]),
                        "a table of label = host name"),
    },
    "merge": {
        "repo": (repo, "owner/name"),
        "gate_check": (lambda v: isinstance(v, str) and v.strip() != "", "a check name"),
        "never_rerun": (names, "a list of distinct check names"),
        "tiers": (lambda v: words(v) and bool(v), "a non-empty list of distinct lowercase words"),
        "preapprove_tiers": (words, "a list of distinct lowercase words"),
    },
    "issues": {
        "repo": (repo, "owner/name"),
        "fixes": (lambda v: text(v) and v.count("{issue}") == 1 and "{" not in v.replace("{issue}", ""),
                   "one line with {issue} once and no other placeholder"),
        "salvaged_from": (lambda v: text(v) and v.endswith(" #{pr}") and "{" not in v[:-5],
                           "one line ending in ` #{pr}`, with no other placeholder"),
        "since": (lambda v: isinstance(v, str) and re.fullmatch(r"\d{4}-\d{2}-\d{2}", v) is not None, "a YYYY-MM-DD date"),
    },
}


def validate(data):
    if type(data.get("schema")) is not int or data["schema"] != 1:
        raise PolicyError(f"schema must be 1, not {data.get('schema')!r}")
    for key in data.keys() - SCHEMA.keys() - {"schema"}:
        raise PolicyError(f"unknown key {key}")
    for name, spec in SCHEMA.items():
        sec = data.get(name)
        if not isinstance(sec, dict) or not sec:
            raise PolicyError(f"[{name}] is missing or empty")
        for k in sec.keys() - spec.keys():
            raise PolicyError(f"unknown key {name}.{k}")
        for k, (check, want) in spec.items():
            if k not in sec:
                raise PolicyError(f"missing {name}.{k}")
            if not check(sec[k]):
                raise PolicyError(f"{name}.{k} must be {want}, not {sec[k]!r}")
    if data["patent"]["public_repo"].lower() == data["patent"]["private_repo"].lower():   # GitHub names ignore case
        raise PolicyError("patent.private_repo must differ from patent.public_repo")
    if extra := [t for t in data["merge"]["preapprove_tiers"] if t not in data["merge"]["tiers"]]:
        raise PolicyError(f"merge.preapprove_tiers names {', '.join(extra)}, which merge.tiers lacks")
    if data["pickup"]["deadline_s"] >= data["pickup"]["interval_s"]:
        raise PolicyError("pickup.deadline_s must be under pickup.interval_s, so a pass ends before the next one is due")
    return data


def read(path):
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except OSError as e:
        raise PolicyError(f"cannot read {path}: {e.strerror}") from None
    except tomllib.TOMLDecodeError as e:
        raise PolicyError(f"{path} is not TOML: {e}") from None


def load(path=PATH):
    return validate(read(path))


def text(v):
    return isinstance(v, str) and v.strip() != "" and v == v.strip()


def keys(where, d, want, optional=()):
    """d is a table with exactly the keys `want` and any of `optional`."""
    if not isinstance(d, dict):
        raise PolicyError(f"{where} must be a table")
    for k in d.keys() - set(want) - set(optional):
        raise PolicyError(f"unknown key {where}.{k}")
    for k in want:
        if k not in d:
            raise PolicyError(f"missing {where}.{k}")


def validate_rules(data, pol):
    """rules.toml: an intro and sections of rules with distinct ids. A rule that states a value the code enforces must
    name policy.toml's copy of it, so the text and the code cannot drift apart: the patent rules name every held word
    and both repos, and the risk rule names every tier."""
    keys("rules", data, ("schema", "intro", "section"))
    if type(data["schema"]) is not int or data["schema"] != 1:
        raise PolicyError(f"rules: schema must be 1, not {data['schema']!r}")
    if not text(data["intro"]) or not isinstance(data["section"], list) or not data["section"]:
        raise PolicyError("rules: intro must be text and section a non-empty list")
    seen = {}
    for n, sec in enumerate(data["section"], 1):
        keys(f"section {n}", sec, ("title", "rule"), ("paragraphs",))
        if not text(sec["title"]) or type(sec.get("paragraphs", False)) is not bool:
            raise PolicyError(f"rules: section {n} needs a title, and paragraphs is true or false")
        if not isinstance(sec["rule"], list) or not sec["rule"]:
            raise PolicyError(f"rules: section {sec['title']!r} has no rule")
        for r in sec["rule"]:
            keys(f"{sec['title']} rule", r, ("id", "text"))
            if not (isinstance(r["id"], str) and re.fullmatch(r"[a-z]+(-[a-z]+)*", r["id"])) or not text(r["text"]) or "\n" in r["text"]:
                raise PolicyError(f"rules: {sec['title']} rule {r.get('id')!r} needs a kebab-case id and one line of text")
            if r["id"] in seen:
                raise PolicyError(f"rules: two rules have the id {r['id']}")
            seen[r["id"]] = r["text"]
    iss = pol["issues"]
    need = {"patent-scope": [w for w in pol["patent"]["held_words"]],
            "issue-close": [f"`{iss['repo']}`"],
            "salvage-fixes": [f"`{iss['salvaged_from'].format(pr='<pr>')}`", f"`{iss['fixes'].format(issue='<issue>')}`"],
            "patent-repo": [w for w in pol["patent"]["held_words"]] + [f"`{pol['patent']['public_repo']}`", f"`{pol['patent']['private_repo']}`"],
            "merge-risk": ["|".join(pol["merge"]["tiers"])],
            "lume-prune": [f"older than {pol['hourly']['lume_prune_age_h']}h"]}
    for rid, words in need.items():
        if rid not in seen:
            raise PolicyError(f"rules: no rule {rid}, which states config/policy.toml's values")
        if miss := [w for w in words if w.lower() not in seen[rid].lower()]:
            raise PolicyError(f"rules: {rid} does not name {', '.join(miss)} from config/policy.toml")
    return data


def rules(path=RULES):
    return validate_rules(read(path), load())


def render(data, ids=()):
    """The Hard rules as markdown: the whole file, or only the rules `ids` names, in the order given."""
    if ids:
        by = {r["id"]: r["text"] for s in data["section"] for r in s["rule"]}
        if miss := [i for i in ids if i not in by]:
            raise PolicyError(f"no rule {', '.join(miss)} in {RULES}")
        return "".join(f"- {by[i]}\n" for i in ids)
    out = ["## Hard rules", "", data["intro"]]
    for s in data["section"]:
        out += ["", f"### {s['title']}", ""]
        out += ("\n\n" if s.get("paragraphs") else "\n").join(
            r["text"] if s.get("paragraphs") else f"- {r['text']}" for r in s["rule"]).split("\n")
    return "\n".join(out) + "\n"


FORMATS = ("json", "toml", "rows", "lines", "tsv", "mark", "lock")


def validate_state(data):
    """state.toml: one [file.<name>] per runtime state file, with its path under $ONIGIRI_ROOT, its format, the one module
    that writes it and the modules that read it (tests/test_state_files.py holds the code to this)."""
    keys("state", data, ("schema", "file"))
    if type(data["schema"]) is not int or data["schema"] != 1:
        raise PolicyError(f"state: schema must be 1, not {data['schema']!r}")
    if not isinstance(data["file"], dict) or not data["file"]:
        raise PolicyError("state: [file] is missing or empty")
    for name, f in data["file"].items():
        keys(f"file.{name}", f, ("path", "host", "format", "writer", "readers", "schema"))
        if not text(f["path"]) or f["path"].startswith("/") or ".." in f["path"].split("/"):
            raise PolicyError(f"state: file.{name}.path must be a path under $ONIGIRI_ROOT")
        if f["format"] not in FORMATS:
            raise PolicyError(f"state: file.{name}.format must be one of {', '.join(FORMATS)}")
        if not text(f["writer"]) or not names(f["readers"]) or not text(f["host"]) or not text(f["schema"]):
            raise PolicyError(f"state: file.{name} needs a host, a writer, a list of readers and a schema line")
    return data


def state(path=STATE):
    return validate_state(read(path))


def get(data, key):
    v = data
    for part in key.split("."):
        if not isinstance(v, dict) or part not in v:
            raise PolicyError(f"no key {key}")
        v = v[part]
    return v


def main(argv):
    try:
        if argv == ["check"]:
            load(), rules(), state()
            return print(f"policy: {os.path.dirname(PATH)}/{{policy,rules,state}}.toml are valid") or 0
        if argv[:1] == ["rules"]:
            return print(render(rules(), argv[1:]), end="") or 0
        if argv == ["dump"]:
            return print(json.dumps(load())) or 0
        if len(argv) == 2 and argv[0] == "get":
            v = get(load(), argv[1])
            return print(v if type(v) in (str, int) else json.dumps(v)) or 0
    except PolicyError as e:
        print(f"policy: {e}", file=sys.stderr)
        return 1
    print(__doc__.split("\n\n")[1], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
