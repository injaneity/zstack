#!/bin/bash
set -eu
pkg="$(cd "$(dirname "$0")/.." && pwd)"
echo "zstack $(git -C "$pkg" rev-parse HEAD 2>/dev/null || echo unknown)" >&2
[ $# -ge 2 ] || { echo "usage: new-brief <id> <role> [auto|chat|quick] < task.md" >&2; exit 2; }
id=$1 role=$2 source=${3:-chat}
case "$id" in [A-Za-z0-9]*) ;; *) echo "new-brief: bad id $id" >&2; exit 2;; esac
case "$source" in auto|chat|quick) ;; *) echo "new-brief: source is auto, chat or quick, not $source" >&2; exit 2;; esac
"$pkg/bin/model-for" "$role" >/dev/null
root=$(python3 -I -c 'import importlib.machinery as m, importlib.util as u, sys
l = m.SourceFileLoader("p", sys.argv[1]); p = u.module_from_spec(u.spec_from_loader("p", l)); l.exec_module(p)
print(p.host_env("list")[1])' "$pkg/bin/pi-run")
d="$root/$id"; f="$d/brief.md"
[ ! -e "$f" ] || { echo "new-brief: $f exists" >&2; exit 3; }
task=$(cat)
[ -n "$task" ] || { echo "new-brief: no task text on stdin" >&2; exit 2; }
salvage=
if printf '%s' "$task" | grep -qi 'salvag'; then
  salvage=$("$pkg/bin/policy" rules salvage-fixes) || exit 1
  salvage="
${salvage#- }
"
fi
mkdir -p "$d"
cat > "$f.tmp" <<BRIEF
# $id ($role)
role: $role
source: $source

$task
$salvage
Follow onigiri-mode's Hard rules (config/rules.toml in zstack; bin/pi-run appends them to your system prompt).
End the report (report.md in this directory, and your final message) with \`follow-ups:\` and \`questions:\`, each "none" when empty. Put PR URLs in it.
No invented limits: a restriction must trace to Zane's words or the policy. If you think one is needed, put it under questions: instead of applying it.
wake: finish
BRIEF
mv "$f.tmp" "$f"
echo "$f"
