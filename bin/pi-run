#!/usr/bin/env python3
import calendar
import fcntl
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time

PKG = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
WAKE = os.path.join(PKG, "hosts", "vm", "wake.py")
ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}")
USAGE = ("usage: pi-run <id> <role> <brief> [pi args...] | pi-run collect|queue <id> | pi-run ci <id> <pr> <head> <why...> "
         "| pi-run stop <id> <why...> "
         "| pi-run list [<state>...]\nexit 0 done, 2 usage, 3 refused by the run's state (bin/PiRun.mmd), 4 setup failed; "
         "PI_RUN_DRY=1 checks a start and changes nothing")
LIMIT = re.compile(r"(Error: )?(Incomplete Claude Code upstream response \(status (429|200|5\d\d|unknown), .*\)"
                   r"|You have hit your ChatGPT usage limit.*)")
STOPPED, STOP_GRACE = "stopped", 30
RESUME = ("Your run stopped on an upstream rate limit or an incomplete upstream response and is resumed in the same session. "
          "Carry on with the task from where you stopped.")
CI_RESUME = ("Your PR trycua/cua#{pr} is red at {head}, the head you pushed, after the merge job's one rerun: {why}. You own its CI, "
             "so this session is reopened to resolve it (fix {n} of {cap}, ci.fix_attempts in config/policy.toml). Read the failing logs, "
             "fix the cause (update from main when it is not in your diff), push, and have the verifier check the new head. "
             "Rerun a job that failed for a reason outside your diff (cancelled, timed out, a runner network failure) "
             "yourself. If only Zane can decide it, say why under questions: and stop.")


def _load_policy():
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader("policy", os.path.join(PKG, "bin", "policy"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    try:
        return mod, mod.load()
    except mod.PolicyError as e:
        return mod, e


_POLICY, _CONFIG = _load_policy()


def policy():
    return _POLICY


POOLS = ("auto", "hand", "quick")


def conf(*keys):
    if isinstance(_CONFIG, Exception):
        die(2, str(_CONFIG))
    v = _CONFIG
    for k in keys:
        v = v[k]
    return v


def field(text, key, default=""):
    return next((x.split(":", 1)[1].strip() for x in text.splitlines() if x.startswith(key + ":")), default)


def tail(p, n=200):
    return ((p.stderr.strip().splitlines() or [f"exit {p.returncode}"])[-1])[:n]


def pool_of(brief, role):
    src = field(brief, "source")
    return src if src in ("auto", "quick") else "quick" if role == "research" else "hand"


def pool_wait(pool, counts, unknown):
    if pool == "quick":
        return ""
    if unknown:
        return f"{', '.join(unknown)} runs unknown, so the {pool} pool count is unknown"
    cap = conf("slots")[pool]
    if counts[pool] >= cap:
        return f"{pool} pool full: {counts[pool]}/{cap} running"
    return ""


class Refused(Exception):
    pass


def utc(t=None):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(t))


def step(run, event, alive=False, **f):
    s = run["state"] if run else "absent"
    if s == "running" and not alive and event != "exit":
        s = "lost"
    cont = continuation(run)
    if event == "queue" and s in ("absent", "queued"):
        return run or {"state": "queued", "attempt": 0, "pid": None, "start": None, "rc": None, "wake_finish": False, "wake": None,
                       "resume_at": None, "since": f["since"], "role": f["role"], "pool": f.get("pool", "hand")}
    if event == "start" and (s == "absent" or s == "queued" and not cont):
        return {**(run or {}), "state": "running", "attempt": (run or {}).get("attempt", 0) + 1, "pid": f["pid"], "start": f["start"],
                "rc": None, "wake_finish": f["wake_finish"], "wake": None, "resume_at": None,
                "since": (run or {}).get("since") or f["now"], "pool": f.get("pool", "hand")}
    if event == "start" and cont and f.get("drain") and f["now"] >= run["resume_at"]:
        return {**run, "state": "running", "pid": f["pid"], "start": f["start"], "rc": None, "resume_at": None,
                "resumes": run.get("resumes", 0) + 1, "ci_now": None}
    if event == "ci" and s == "collected":
        heads = (run.get("ci") or {}).get(f["pr"], [])
        if f["head"] in heads:
            raise Refused(f"already reopened for cua#{f['pr']} at {f['head']}")
        if len(heads) >= f["cap"]:
            raise Refused(f"fix attempts spent for cua#{f['pr']}: {len(heads)} of {f['cap']} ({', '.join(heads)})")
        return {**{k: v for k, v in run.items() if k != "stopped"}, "state": "queued", "rc": None, "wake": None, "resume_at": f["now"],
                "ci": {**(run.get("ci") or {}), f["pr"]: heads + [f["head"]]},
                "ci_now": {"pr": f["pr"], "head": f["head"], "why": f["why"], "n": len(heads) + 1, "cap": f["cap"]}}
    if event == "exit" and s == "running" and run["pid"] == f["pid"] and f.get("stopped"):
        return {**run, "state": "exited", "rc": f["rc"], "wake": None, "stopped": f["stopped"]}
    if event == "exit" and s == "running" and run["pid"] == f["pid"]:
        n = run.get("limit_resumes", 0)
        if f["rc"] and f.get("resume_at") and n < f["cap"]:
            return {**run, "state": "queued", "rc": f["rc"], "resume_at": f["resume_at"], "limit_resumes": n + 1}
        wake = "failed" if f["rc"] else "done" if run.get("wake_finish") else None
        return {**run, "state": "exited", "rc": f["rc"], "wake": wake}
    if event == "collect" and s in ("exited", "lost"):
        if s == "lost" and f.get("stopped"):
            return {**run, "state": "collected", "wake": None, "stopped": f["stopped"]}
        return {**run, "state": "collected", "wake": "failed" if s == "lost" else run.get("wake")}
    raise Refused({
        ("start", "running"): f"already running (pid {run and run['pid']})",
        ("start", "exited"): f"attempt {run and run['attempt']} exited rc={run and run['rc']} and is not collected",
        ("start", "lost"): f"attempt {run and run['attempt']} was lost and is not collected",
        ("start", "collected"): f"attempt {run and run['attempt']} was collected; a retry is a fresh id",
        ("start", "queued"): f"queued after a 429 until {run and run.get('resume_at')}; the hourly drain resumes it"
                             + (" once that has passed" if f.get("drain") else ""),
        ("queue", "collected"): f"attempt {run and run['attempt']} was collected; a retry is a fresh id",
        ("ci", "running"): "still running: the session is at work",
        ("ci", "exited"): "exited and not collected yet",
        ("collect", "running"): "still running",
        ("collect", "queued"): "queued: nothing to collect yet",
    }.get((event, s), f"no {event} from {s}"))


def starttime(pid):
    r = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True,
                       env={"LC_ALL": "C", "TZ": "UTC", "PATH": "/bin:/usr/bin"})
    return r.stdout.strip()


def alive(run):
    if not run or run["state"] != "running":
        return False
    now = starttime(run["pid"])
    if now:
        return now == run["start"]
    try:
        os.killpg(run["pid"], 0)
        return True
    except OSError:
        return False


def read_json(p):
    if not os.path.exists(p):
        return None
    with open(p) as f:
        return json.load(f)


class Run:
    def __init__(self, d):
        self.d, self.path = d, os.path.join(d, "run.json")

    def __enter__(self):
        self.fd = os.open(self.d, os.O_RDONLY)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        self.run = read_json(self.path)
        return self

    def write(self, run):
        with open(self.path + ".tmp", "w") as f:
            json.dump(run, f)
        os.replace(self.path + ".tmp", self.path)
        self.run = run

    def __exit__(self, *a):
        os.close(self.fd)


def sha():
    r = subprocess.run(["git", "-C", PKG, "rev-parse", "HEAD"], capture_output=True, text=True)
    return r.stdout.strip() or "unknown"


def die(code, msg):
    print(f"pi-run: {msg}", file=sys.stderr)
    sys.exit(code)


def host_name():
    if "ONIGIRI_HOST" in os.environ:
        return os.environ["ONIGIRI_HOST"]
    try:
        return open(os.path.expanduser("~/.config/onigiri/host")).read().strip()
    except OSError:
        return ""


def host_env(cmd):
    env, host = dict(os.environ), host_name()
    if host:
        env["ONIGIRI_HOST"] = host
        f = os.path.join(PKG, "hosts", host, "host.sh")
        if not os.path.isfile(f):
            die(2, f"no host file {f}")
        dump = "import json, os; print(json.dumps(dict(os.environ)))"
        r = subprocess.run(["bash", "-c", '. "$1" "$2" >&2 && exec "$3" -c "$4"', "_", f, cmd, sys.executable, dump],
                           stdout=subprocess.PIPE, text=True, env=env)
        if r.returncode:
            die(4, f"{f} failed (exit {r.returncode})")
        env = json.loads(r.stdout)
    return env, os.path.join(env.get("ONIGIRI_ROOT") or os.path.expanduser("~/onigiri"), "review")


def attempt_text(d, attempt):
    try:
        with open(os.path.join(d, "run.log"), errors="replace") as f:
            return f.read().split(f"== attempt {attempt}\n")[-1]
    except OSError:
        return ""


def last_line(d, attempt):
    return ([x for x in attempt_text(d, attempt).splitlines() if x.strip()] or [""])[-1].strip()


def limit_until(last, rc, got):
    if not rc or got or not LIMIT.fullmatch(last):
        return None
    m = re.search(r"Try again in ~(\d+) min", last)
    return utc(time.time() + 60 * int(m.group(1)) if m else None)


def _entries_tail(path, size=262144):
    try:
        total = os.path.getsize(path)
        with open(path, "rb") as f:
            while True:
                f.seek(max(0, total - size))
                lines = f.read().decode("utf-8", "replace").splitlines()
                if size < total:
                    lines = lines[1:]
                out = []
                for line in lines:
                    try:
                        out.append(json.loads(line))
                    except ValueError:
                        pass
                if size >= total or any((e.get("message") or {}).get("role") == "assistant" for e in out):
                    return out
                size *= 2
    except OSError:
        return []


def _stamp(entry):
    try:
        return calendar.timegm(time.strptime(entry["timestamp"][:19], "%Y-%m-%dT%H:%M:%S"))
    except (KeyError, TypeError, ValueError):
        return None


def session_progress(path):
    entries = [e for e in _entries_tail(path) if e.get("type") != "usage" and _stamp(e)]
    if not entries:
        return 0
    last, done = _stamp(entries[-1]), set()
    for e in reversed(entries):
        m = e.get("message") or {}
        if m.get("role") == "toolResult":
            done.add(m.get("toolCallId"))
            continue
        if m.get("role") == "assistant" and isinstance(m.get("content"), list):
            ends = [_stamp(e) + x["arguments"]["timeout"] for x in m["content"]
                    if x.get("type") == "toolCall" and x.get("id") not in done
                    and isinstance((x.get("arguments") or {}).get("timeout"), (int, float))]
            return max([last] + ends)
        break
    return last


def session_files(d, sid):
    agent = os.environ.get("PI_CODING_AGENT_DIR") or os.path.expanduser("~/.pi/agent")
    sessions, out = os.path.join(agent, "sessions"), []
    for p in {d, os.path.realpath(d)}:
        s = os.path.join(sessions, "--" + p.strip("/").replace("/", "-") + "--")
        out += [os.path.join(s, f) for f in (os.listdir(s) if os.path.isdir(s) else []) if f.endswith(".jsonl")]
    child = re.compile(r"[^_]+_" + re.escape(sid) + r"-[a-z]+(-\d+)?-\w+\.jsonl")
    sub = os.path.join(sessions, "subagents")
    out += [os.path.join(sub, f) for f in (os.listdir(sub) if os.path.isdir(sub) else []) if child.fullmatch(f)]
    return out


def files_progress(d, since):
    newest = 0
    for root, dirs, files in os.walk(d):
        dirs[:] = [x for x in dirs if not (root == d and x.startswith("wt")) and x not in (".git", "target", "node_modules")]
        for x in files:
            try:
                newest = max(newest, os.lstat(os.path.join(root, x)).st_mtime)
            except OSError:
                continue
            if newest > since:
                return newest
    return newest


def last_progress(d, sid, since=float("inf")):
    try:
        t = os.path.getmtime(os.path.join(d, "run.log"))
    except OSError:
        t = 0
    for p in session_files(d, sid):
        if t > since:
            return t
        t = max(t, session_progress(p))
    return t if t > since else max(t, files_progress(d, since))


def supervise(d, sid, cmd, env, cap, idle):
    os.setsid()
    log = os.open(os.path.join(d, "run.log"), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    os.dup2(os.open(os.devnull, os.O_RDONLY), 0)
    os.dup2(log, 1)
    os.dup2(log, 2)
    proc, got = None, []

    def fwd(sig, _):
        got.append(sig)
        if proc:
            proc.send_signal(sig)
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, fwd)
    with Run(d) as r:
        if not r.run or r.run["pid"] != os.getpid():
            os._exit(1)
        print(f"== attempt {r.run['attempt']}" + (" resumed" if r.run.get("resumes") else ""), flush=True)
    rc = None
    if not got:
        try:
            proc = subprocess.Popen(cmd, cwd=d, env=env)
        except OSError as e:
            print(f"pi-run: cannot start pi: {e}", flush=True)
            rc = 127
        if got and proc:
            proc.send_signal(got[0])
    stalled = 0
    while rc is None and proc is not None:
        try:
            rc = proc.wait(timeout=min(60, max(1, idle // 10)))
        except subprocess.TimeoutExpired:
            quiet = time.time() - last_progress(d, sid, since=time.time() - idle)
            if quiet >= idle and not stalled:
                stalled = int(quiet // 60)
                print(f"pi-run: no progress for {stalled} min, past run.idle_min in config/policy.toml: stopping pi", flush=True)
                proc.send_signal(signal.SIGTERM)
                try:
                    rc = proc.wait(timeout=30)
                except subprocess.TimeoutExpired:
                    proc.kill()
    if rc is None:
        rc = 128 + got[0]
    killed, rc = rc < 0, 128 - rc if rc < 0 else rc
    if stalled:
        killed, rc = True, rc or 128 + signal.SIGTERM
    with Run(d) as r:
        last = last_line(d, r.run["attempt"])
        until = limit_until(last, rc, got or killed)
        done = step(r.run, "exit", pid=os.getpid(), rc=rc, resume_at=until, cap=cap, stopped=stop_mark(d))
        why = f"{sid} exited rc={rc}" + (f": stopped after {stalled} min with no progress (run.idle_min)" if stalled else "")
        if done["state"] == "queued":
            print(f"pi-run: back in the queue after an upstream limit ({done['limit_resumes']} of {cap} resumes); "
                  f"the hourly drain resumes it after {done['resume_at']}", flush=True)
        elif until:
            why += (f": stopped on an upstream limit again after {cap} resumes, the resume.cap in config/policy.toml, "
                    f"so it ends failed. pi's last line: {last}")
            print(f"pi-run: {why}", flush=True)
        if done.get("wake"):
            try:
                subprocess.run([sys.executable, WAKE, done["wake"], why, f"rc={rc}",
                                *report_fields(d, done["attempt"])], env=env)
            except OSError as e:
                print(f"pi-run: wake not sent: {e}", flush=True)
        r.write(done)
    os._exit(rc)


def report_fields(d, attempt):
    prs = dict.fromkeys(re.findall(r"https://github\.com/[\w.-]+/[\w.-]+/pull/\d+", attempt_text(d, attempt)))
    return [f"report={os.path.join(d, 'run.log')}"] + ([f"prs={','.join(prs)}"] if prs else [])


def check(d, sid, run=False, **f):
    if run is False:
        run = read_json(os.path.join(d, "run.json"))
    try:
        step(run, "start", alive(run), pid=0, start="", wake_finish=False, **f)
    except Refused as e:
        die(3, f"{sid}: {e}")


def on_main(argv, script=__file__):
    if not os.environ.get("ZSTACK_ENSURED"):
        if subprocess.run([os.path.join(PKG, "bin", "ensure-package-main")], stdout=sys.stderr).returncode:
            sys.exit(4)
        os.execve(sys.executable, [sys.executable, os.path.realpath(script), *argv], {**os.environ, "ZSTACK_ENSURED": "1"})
    os.environ.pop("ZSTACK_ENSURED")


def launch(sid, role, brief, extra):
    on_main([sid, role, brief, *extra])
    if not os.path.isfile(brief) or not os.access(brief, os.R_OK):
        die(2, f"cannot read brief {brief}")
    env, root = host_env("dry" if os.environ.get("PI_RUN_DRY") else "start")
    d, f = os.path.join(root, sid), dict(drain=os.environ.get("PI_RUN_DRAIN") == "1", now=utc())
    run = read_json(os.path.join(d, "run.json"))
    cont = continuation(run)
    pool = run["pool"] if run else pool_of(open(brief).read(), role)
    if cont:
        role, extra = run.get("role") or role, run.get("extra") or []
        text = CI_RESUME.format(**run["ci_now"]) if run.get("ci_now") else RESUME
        with open(os.path.join(d, "brief.full.md")) as fh:
            brief_text = fh.read()
    else:
        prefix = env.get("ONIGIRI_BRIEF_PREFIX")
        text = brief_text = "".join(open(x).read() for x in (prefix, brief) if x)
    pol = policy()
    try:
        provider, model = pol.model_for(role, conf())
    except pol.PolicyError as e:
        die(2, str(e))
    cap, idle = conf("resume", "cap"), conf("run", "idle_min") * 60
    check(d, sid, run, **f)
    try:
        ls = subprocess.run(["pi", "--list-models"], env=env, capture_output=True, text=True).stdout
    except OSError as e:
        die(4, f"{sid}: cannot run pi in the launch env: {e}")
    if not any(x.split()[:1] == [provider] for x in ls.splitlines()):
        die(4, f"{sid}: no {provider} credential in the launch env: `pi --list-models` lists no {provider} model "
               f"(host file: {env.get('ONIGIRI_HOST') or 'none'}). Log in, or name the host file that loads it with ONIGIRI_HOST "
               "or ~/.config/onigiri/host; bin/check-host lists what this host lacks. Nothing started.")
    gate = None if cont or f["drain"] or os.environ.get("PI_RUN_COUNTED") == "1" else slots_gate(root, d, sid, role, pool, brief)
    if os.environ.get("PI_RUN_DRY"):
        print(f"pi-run: dry run, would {'resume' if cont else 'start'} {sid} in {d} as role {role}: {provider} {model}")
        return 0
    try:
        rules = pol.render(pol.rules())
    except pol.PolicyError as e:
        die(2, f"no Hard rules: {e}")
    env.pop("PI_RUN_DRAIN", None)
    env.pop("PI_RUN_COUNTED", None)
    env.update(ONIGIRI_WAKE=WAKE, PI_SESSION_ID=sid, ONIGIRI_READY_ALLOWED="1" if "merge: allowed" in brief_text.splitlines() else "0")
    cmd = ["pi", "--session-id", sid, "--provider", provider, "--model", model, "--name", f"role:{role}",
           "--append-system-prompt", os.path.join(d, "rules.md"), *extra, "-p", "--", text]
    os.makedirs(d, exist_ok=True)
    with Run(d) as r:
        check(d, sid, r.run, **f)
        if continuation(r.run) != cont or (r.run or {}).get("ci_now") != (run or {}).get("ci_now"):
            die(3, f"{sid}: its state changed during setup; nothing started")
        with open(os.path.join(d, "rules.md"), "w") as fh:
            fh.write(rules)
        if not cont:
            with open(os.path.join(d, "brief.full.md"), "w") as fh:
                fh.write(text)
        sys.stdout.flush()
        sys.stderr.flush()
        pid = os.fork()
        if pid == 0:
            os.close(r.fd)
            gate is None or os.close(gate)
            try:
                supervise(d, sid, cmd, env, cap, idle)
            finally:
                os._exit(1)
        new = step(r.run, "start", alive(r.run), pid=pid, start=starttime(pid), wake_finish="wake: finish" in text.splitlines(),
                   pool=pool, **f)
        r.write(new if cont else {**new, "role": role, "extra": extra})
    gate is None or os.close(gate)
    print(f"pi-run: {'resumed' if cont else 'started'} {sid} attempt {r.run['attempt']} pid {pid} in {d} as role {role}: {provider} {model}")
    return 0


def slots_gate(root, d, sid, role, pool, brief):
    if pool == "quick":
        return None
    dry = bool(os.environ.get("PI_RUN_DRY"))
    dry or os.makedirs(os.path.dirname(root), exist_ok=True)
    fd = None if dry else os.open(os.path.join(os.path.dirname(root), "slots.lock"), os.O_RDWR | os.O_CREAT, 0o644)
    dry or fcntl.flock(fd, fcntl.LOCK_EX)
    try:
        p = subprocess.run([os.path.join(PKG, "bin", "hourly"), "pools"], capture_output=True, text=True)
    except OSError as e:
        p = subprocess.CompletedProcess([], 127, "", str(e))
    try:
        got = json.loads(p.stdout)
        why = pool_wait(pool, got["running"], got["unknown"])
    except (ValueError, KeyError, TypeError):
        why = "the pool count failed: " + tail(p)
    if not why:
        return fd
    dry or os.close(fd)
    if dry:
        print(f"pi-run: dry run, would queue {sid} ({pool} pool), not start it: {why}")
        sys.exit(0)
    os.makedirs(d, exist_ok=True)
    here = os.path.join(d, "brief.md")
    if not os.path.exists(here):
        with open(here, "w") as fh:
            fh.write(open(brief).read())
    elif os.path.realpath(here) != os.path.realpath(brief) and open(here).read() != open(brief).read():
        die(3, f"{sid}: {why}, and review/{sid}/brief.md differs from {brief}, so it cannot be queued; nothing started")
    with Run(d) as r:
        try:
            r.write(step(r.run, "queue", alive(r.run), since=utc(), role=role, pool=pool))
        except Refused as e:
            die(3, f"{sid}: {e}")
    print(f"pi-run: {sid} queued, not started: {why}. The hourly drain starts it once the {pool} pool has room "
          f"(config/policy.toml [slots]; `bin/hourly queue` on the hourly host drains now); no running session is stopped for it.")
    sys.exit(0)


def collect(sid):
    env, root = host_env("collect")
    d = os.path.join(root, sid)
    if not os.path.exists(os.path.join(d, "run.json")):
        die(3, f"{sid}: nothing to collect")
    with Run(d) as r:
        lost = r.run["state"] == "running" and not alive(r.run)
        try:
            done = step(r.run, "collect", not lost, stopped=stop_mark(d))
        except Refused as e:
            die(3, f"{sid}: {e}")
        if lost and done.get("wake"):
            subprocess.run([sys.executable, WAKE, "failed", f"{sid} was lost (KILL or OOM) at attempt {done['attempt']}",
                            *report_fields(d, done["attempt"])], env={**env, "PI_SESSION_ID": sid}, stdout=sys.stderr)
        r.write(done)
        line = prune(d)
        if line:
            print(f"pi-run: {sid}: {line}", file=sys.stderr)
            with open(os.path.join(d, "run.log"), "a") as fh:
                fh.write(f"pi-run collect: {line}\n")
    rc = r.run["rc"]
    print(f"{sid} attempt={r.run['attempt']} " + (f"rc={rc}" if rc is not None else "lost"))
    return 0


def build_dirs(d):
    real, found = os.path.realpath(d), []
    for wt in sorted(os.listdir(d)):
        top = os.path.join(d, wt)
        if not wt.startswith("wt") or os.path.islink(top) or not os.path.isdir(top):
            continue
        for root, dirs, _ in os.walk(top):
            dirs[:] = [x for x in dirs if x not in (".git", "node_modules") and not os.path.islink(os.path.join(root, x))]
            for name in [x for x in dirs if x == "target" or x.startswith(".target.pruning-")]:
                if os.path.isfile(os.path.join(root, name, "CACHEDIR.TAG")):
                    dirs.remove(name)
                    t = os.path.realpath(os.path.join(root, name))
                    if t.startswith(real + os.sep):
                        found.append((t, os.path.realpath(top)))
    return found


def open_paths():
    lsof = shutil.which("lsof", path=os.environ.get("PATH", "") + ":/usr/sbin:/usr/bin")
    try:
        p = subprocess.run([lsof or "lsof", "-n", "-P", "-w", "-Fn"], capture_output=True, text=True, errors="replace", timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    paths = [x[1:] for x in p.stdout.splitlines() if x.startswith("n/")]
    return paths if paths else None


def disk_bytes(path):
    total = 0
    for root, dirs, files in os.walk(path):
        for x in dirs + files:
            try:
                total += os.lstat(os.path.join(root, x)).st_blocks * 512
            except OSError:
                pass
    return total


def held_in(paths, held):
    return any(x == p or x.startswith(p + os.sep) for p in paths for x in held)


def prune(d):
    try:
        targets = build_dirs(d)
        if not targets:
            return ""
        held = open_paths()
        if held is None:
            return f"kept {len(targets)} target/ dir(s): lsof gave no answer"
        freed, gone, kept = 0, [], []
        for t, wt in targets:
            if held_in([wt], held):
                kept.append(t)
                continue
            aside = os.path.join(os.path.dirname(t), f".target.pruning-{os.getpid()}")
            os.rename(t, aside)
            now = open_paths()
            if now is None or held_in([wt, aside], now):
                os.path.exists(t) or os.rename(aside, t)
                kept.append(t)
                continue
            size = disk_bytes(aside)
            shutil.rmtree(aside, ignore_errors=True)
            if os.path.exists(aside):
                kept.append(aside)
            else:
                freed += size
                gone.append(t)
        rel = lambda xs: " ".join(os.path.relpath(x, os.path.realpath(d)) for x in xs)   # noqa: E731
        return (f"freed {freed / 1e9:.1f} GB: deleted {rel(gone) or 'no target/ dir'}"
                + (f"; kept {rel(kept)} (held open or not removable)" if kept else ""))
    except Exception as e:   # noqa: BLE001
        return f"prune failed: {type(e).__name__}: {e}"


def continuation(run):
    return bool(run and run["state"] == "queued" and run.get("resume_at"))


def list_runs(states):
    _, root = host_env("list")
    for sid in sorted(os.listdir(root)) if os.path.isdir(root) else []:
        run = read_json(os.path.join(root, sid, "run.json")) if os.path.exists(os.path.join(root, sid, "run.json")) else None
        if not run:
            continue
        s = "lost" if run["state"] == "running" and not alive(run) else run["state"]
        extra = "".join(f" {k}={run[k]}" for k in ("since", "resume_at") if s == "queued" and run.get(k))
        if not states or s in states:
            print(f"{sid} {s} attempt={run['attempt']} rc={run['rc']}{extra}")
    return 0


def stop_mark(d):
    try:
        with open(os.path.join(d, STOPPED), errors="replace") as f:
            return f.read().strip() or "stopped"
    except OSError:
        return None


def stop(sid, why):
    _, root = host_env("list")
    d = os.path.join(root, sid)
    if not os.path.exists(os.path.join(d, "run.json")):
        die(3, f"{sid}: no run")
    with Run(d) as r:
        if not alive(r.run):
            die(3, f"{sid}: not running ({r.run['state']}); nothing to stop")
        run = r.run
        with open(os.path.join(d, STOPPED + ".tmp"), "w") as f:
            f.write(f"{utc()} {why}\n")
        os.replace(os.path.join(d, STOPPED + ".tmp"), os.path.join(d, STOPPED))
    try:
        os.kill(run["pid"], signal.SIGTERM)
    except ProcessLookupError:
        pass
    end = time.time() + STOP_GRACE
    while alive(run) and time.time() < end:
        time.sleep(0.2)
    if alive(run):
        try:
            os.killpg(run["pid"], signal.SIGKILL)
        except ProcessLookupError:
            pass
    print(f"pi-run: stopped {sid} on purpose ({why}); its exit sends no wake")
    return 0



def ci(sid, pr_n, head, why):
    _, root = host_env("list")
    d = os.path.join(root, sid)
    if not os.path.exists(os.path.join(d, "run.json")):
        die(3, f"{sid}: no run")
    cap = conf("ci", "fix_attempts")
    with Run(d) as r:
        try:
            r.write(step(r.run, "ci", alive(r.run), pr=pr_n, head=head, why=why, now=utc(), cap=cap))
        except Refused as e:
            die(3, f"{sid}: {e}")
        try:
            os.remove(os.path.join(d, STOPPED))
        except FileNotFoundError:
            pass
    n = r.run["ci_now"]
    print(f"{sid} queued for cua#{pr_n} at {head}: fix {n['n']} of {n['cap']}")
    return 0


def queue(sid):
    _, root = host_env("list")
    d = os.path.join(root, sid)
    brief = os.path.join(d, "brief.md")
    if not os.path.isfile(brief):
        die(2, f"no brief at {brief}; write it with bin/new-brief {sid} <role>")
    text = open(brief).read()
    role = field(text, "role", "coding")
    with Run(d) as r:
        try:
            r.write(step(r.run, "queue", alive(r.run), since=utc(), role=role, pool=pool_of(text, role)))
        except Refused as e:
            die(3, f"{sid}: {e}")
    print(f"{sid} queued role={r.run['role']} pool={r.run['pool']} since={r.run['since']}")
    return 0


def main(argv):
    print(f"zstack {sha()}", file=sys.stderr)
    if argv[:1] in (["-h"], ["--help"]):
        print(USAGE)
        return 0
    if len(argv) == 2 and argv[0] in ("collect", "queue") and ID.fullmatch(argv[1]):
        return {"collect": collect, "queue": queue}[argv[0]](argv[1])
    if len(argv) >= 5 and argv[0] == "ci" and ID.fullmatch(argv[1]) and argv[2].isdigit() and re.fullmatch(r"[0-9a-f]{7,40}", argv[3]):
        return ci(argv[1], argv[2], argv[3], " ".join(argv[4:]))
    if argv[:1] == ["list"]:
        return list_runs(argv[1:])
    if len(argv) >= 3 and argv[0] == "stop" and ID.fullmatch(argv[1]):
        return stop(argv[1], " ".join(argv[2:]))
    if len(argv) >= 3 and ID.fullmatch(argv[0]) and argv[0] not in ("collect", "queue", "list", "ci", "stop"):
        return launch(argv[0], argv[1], argv[2], argv[3:])
    die(2, USAGE)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
