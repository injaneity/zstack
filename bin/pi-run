#!/bin/bash
# pi-run <session-id> [<provider> <model>] <promptfile> [extra pi args...]
# Starts one print-mode pi session with onigiri-mode's Hard rules appended to its system prompt.
set -eu
usage() {
  cat <<'USAGE'
usage: pi-run <session-id> [<provider> <model>] <promptfile> [extra pi args...]

A first word that is a file with a / or . in its name is the prompt file.
Model: <provider> <model> when given, otherwise pi's own default (defaultProvider and
defaultModel in <agent dir>/settings.json, or what `pi` picks with none set).

The "## Hard rules" section of skills/onigiri-mode/SKILL.md (bin/hard-rules) is appended to the
system prompt. Without it pi-run exits 2 and starts nothing.

pi-run sources no profile. Export your provider's credentials before calling it.
USAGE
}
case "${1:-}" in -h|--help) usage; exit 0;; '') usage >&2; exit 2;; esac
[ $# -ge 2 ] || { usage >&2; exit 2; }
pkg="$(cd "$(dirname "$0")/.." && pwd)"
session=$1; shift
args=(--session-id "$session")
# The first word is the brief when it is a file and either looks like a path (has a / or .), which no
# provider name does, or no file follows it as a third word. Otherwise it and the next are provider and model.
case "$1" in */*|*.*) pathlike=1;; *) pathlike=0;; esac
if ! { [ -f "$1" ] && { [ $pathlike = 1 ] || [ $# -lt 3 ] || [ ! -f "$3" ]; }; }; then
  [ $# -ge 3 ] && [ "${1#-}" = "$1" ] && [ "${2#-}" = "$2" ] || { usage >&2; exit 2; }
  args+=(--provider "$1" --model "$2"); shift 2
fi
prompt=$1; shift
[ -r "$prompt" ] || { echo "pi-run: cannot read prompt file $prompt" >&2; exit 2; }
rules=$("$pkg/bin/hard-rules") || exit 2
args+=(--append-system-prompt "$rules")
exec pi "${args[@]}" "$@" -p -- "$(cat "$prompt")"
