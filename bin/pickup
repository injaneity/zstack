#!/usr/bin/env python3
"""pickup: the scheduled pickup pass, on this host, with no chat in the loop. The model is model/Pickup.tla.

  pickup          one pass: collect, drain the queue, pick from GitHub, and wake the chat only when there is something new
  pickup --dry    the same reads, printed as a plan: nothing collected, launched, logged, written or sent, and no lock

hosts/mini/install-pickup.sh runs it from a launchd StartInterval job (config/policy.toml [pickup] interval_s). A pass:

  0. Moves the package to origin/main (bin/ensure-package-main), then takes $ONIGIRI_ROOT/pickup/pickup.lock with flock -n.
     A pass that finds it held logs `pass-locked` and exits 0: passes never overlap.
  1. Collects every exited or lost run on every host (bin/pi-run collect), after its report's PR links, follow-ups:,
     questions: and drafts: are in the outbox (pickup/state.json unsent), so a pass killed at any point loses none.
  2. Drains every host's queue (bin/hourly queue): red PRs back to their threads, then queued runs, under the caps.
  3. Picks from GitHub (trycua/cua, the host's gh login), oldest first with `urgent` ahead: issues assigned to injaneity,
     open PRs requesting injaneity's review (a first review per head), and our PRs the merge job leaves to a session that
     no thread took back (an unstick per head). While the auto pool has room (config/policy.toml [slots] auto), each candidate not taken
     before (a review id on a host, or a launch row) is launched on the launch host, or skipped with one pickup.log row
     naming the one rule that holds: held, pr, overlap, zane, host (playbooks/hourly.md step 5).
  4. Reports four lists, as the chat's pass did, and one more for the chat: needs-Zane, dumpling results,
     outside-contributor drafts, teammate comment drafts, and chat (follow-ups to file, hung runs, disk to prune, and
     salvage links to fix or close: config/policy.toml [issues], playbooks/hourly.md step 7).
  5. Wakes the chat ($ONIGIRI_WAKE, else hosts/vm/wake.py: `done`; `failed` for a pass that died or hit deadline_s) when the outbox holds
     results or a list item is not in the last delivered wake. Nothing new: no wake. Only a delivered wake empties the
     outbox and records the items as seen; an item that goes away is dropped, so its return wakes again.

The parent holds the lock and the deadline. The pass runs in a child in its own process group, which the parent kills at
[pickup] deadline_s; pi runs it launched are in their own sessions (bin/pi-run's supervisor calls setsid) and live on.
Exit codes: 0 a pass ran or the lock was held, 1 the pass failed, 4 the package could not move to main.
"""
from __future__ import annotations

import fcntl
import importlib.machinery
import importlib.util
import json
import os
import re
import signal
import subprocess
import sys
import time

PKG = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, os.path.join(PKG, path))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


hourly = load("hourly", "bin/hourly")
pr = hourly.pr
CFG = hourly._policy["pickup"]   # interval_s, deadline_s, label_hosts: config/policy.toml [pickup]
ISSUES = hourly._policy["issues"]   # repo, fixes, salvaged_from, since: config/policy.toml [issues]
REPO, ME = hourly.REPO, hourly.ME
RULES = ("held", "pr", "overlap", "zane", "host")   # playbooks/hourly.md step 5: the only reasons a candidate is skipped
URL = re.compile(r"https://github\.com/[\w.-]+/[\w.-]+/pull/\d+")
SECTIONS = ("follow-ups", "questions", "drafts")


# ---------------- reading GitHub and the hosts ----------------

def gh(errors, *args):
    """gh's JSON, or [] with an error line: a source GitHub could not give is unknown, never empty."""
    p = hourly.run(["gh", *args])
    try:
        return json.loads(p.stdout) if not p.returncode else errors.append(
            f"gh {' '.join(args[:3])}: " + (p.stderr.strip().splitlines() or [f"exit {p.returncode}"])[-1][:150]) or []
    except ValueError:
        errors.append(f"gh {' '.join(args[:3])}: not JSON")
        return []


def holds(text):
    """{"hold": {pr}, "skip": {login}, "review_only": {login}} from the holds file's rows (docs/HOST.md, Holds file)."""
    h = {"hold": set(), "skip": set(), "review_only": set()}
    for line in (text or "").splitlines():
        f = [x.strip() for x in line.split("|")]
        if line.lstrip().startswith("#") or len(f) < 2:
            continue
        if f[0] == "hold" and f[1].lstrip("#").isdigit():
            h["hold"].add(int(f[1].lstrip("#")))
        elif f[0] in ("skip-author", "review-only"):
            h["skip" if f[0] == "skip-author" else "review_only"].add(f[1])
    return h


def bot(author):
    return bool(author.get("is_bot")) or author["login"].startswith("app/") or author["login"].endswith("[bot]")


def candidates(errors, waits, owned):
    """Every GitHub candidate, as dicts {id, kind, n, head, author, title, url, created, labels, linked, why}."""
    out = []
    for i in gh(errors, "issue", "list", "-R", REPO, "--assignee", ME, "--state", "open", "--limit", "1000",
                "--json", "number,title,url,createdAt,labels,closedByPullRequestsReferences,author"):
        out.append(dict(id=f"cua-{i['number']}", kind="issue", n=i["number"], head=None, author=i["author"], title=i["title"],
                        url=i["url"], created=i["createdAt"], labels=[x["name"] for x in i["labels"]],
                        linked=[x["number"] for x in i.get("closedByPullRequestsReferences") or []], why=""))
    for p in gh(errors, "pr", "list", "-R", REPO, "--state", "open", "--search", f"review-requested:{ME}", "--limit", "1000",
                "--json", "number,title,url,createdAt,labels,headRefOid,author"):
        out.append(dict(id=f"cua-{p['number']}-review-{p['headRefOid'][:7]}", kind="review", n=p["number"], head=p["headRefOid"],
                        author=p["author"], title=p["title"], url=p["url"], created=p["createdAt"],
                        labels=[x["name"] for x in p["labels"]], linked=[], why=""))
    for w in waits:   # `cua#N <head9> wait who=session: <why>` that bin/hourly queue gave back to no thread
        m = re.fullmatch(r"cua#(\d+) ([0-9a-f]+) wait who=session: (.*)", w)
        if m and int(m[1]) not in owned:
            out.append(dict(id=f"cua-{m[1]}-unstick-{m[2][:7]}", kind="unstick", n=int(m[1]), head=m[2], author={"login": ME},
                            title=m[3], url=f"https://github.com/{REPO}/pull/{m[1]}", created="", labels=[], linked=[], why=m[3]))
    return sorted(out, key=lambda c: ("urgent" not in c["labels"], c["created"] or "9", c["id"]))


def open_prs(errors):
    """{number: draft} for every open trycua/cua PR: an issue with an open linked PR is owned by it."""
    return {p["number"]: p["isDraft"] for p in gh(errors, "pr", "list", "-R", REPO, "--state", "open", "--limit", "3000",
                                                  "--json", "number,isDraft")}


def launch_host(hosts, needs=None):
    """playbooks/hourly.md step 3: a peer only at main with the floor free, else this host; with `needs`, that host or none.
    A host with an auto pause (bin/hourly paused()) takes no pick: every pick is an auto run."""
    ok = [h for h, f in hosts.items() if "error" not in f and not hourly.paused(hosts, h)
          and (h == hourly.SELF or (f.get("at_main") and f.get("free_gb", 0) >= hourly.FLOOR_GB))]
    if needs:
        return needs if needs in ok else None
    peers = [h for h in ok if h != hourly.SELF]
    return peers[0] if peers else hourly.SELF if hourly.SELF in ok else None


def rule(c, h, prs, live, zane, hosts):
    """(the one skip rule that holds for candidate c, or None; the host it launches on). A platform label names the host
    that can do it (config/policy.toml [pickup] label_hosts); with none, or more than one, the launch host takes it."""
    if bot(c["author"]) or c["author"]["login"] in h["skip"] or "hold" in c["labels"] or (c["kind"] != "issue" and c["n"] in h["hold"]):
        return "held", None
    if any(n in h["hold"] for n in c["linked"]):
        return "held", None
    if c["kind"] == "issue" and any(n in prs for n in c["linked"]):
        return "pr", None
    if c["n"] in live or any(n in live for n in c["linked"]):
        return "overlap", None
    if c["kind"] != "issue" and c["n"] in zane:
        return "zane", None
    want = {CFG["label_hosts"][x] for x in c["labels"] if x in CFG["label_hosts"]}
    there = launch_host(hosts, want.pop()) if len(want) == 1 else launch_host(hosts)
    return ("host", None) if there is None else (None, there)


def salvage_lines(n):
    """The two body lines a salvage of PR n carries (Hard rules, salvage-fixes), from config/policy.toml [issues]."""
    return ISSUES["salvaged_from"].format(pr=n), ISSUES["fixes"].format(issue="<issue>")


def salvage_check(errors, h):
    """Chat items for our salvage PRs (Hard rules, salvage-fixes and issue-close), as [key, text]: an open salvage missing a
    `fixes` line for an open issue its source PR closes, and, for one merged since [issues] since, an issue it left open
    or a source PR still open (playbooks/hourly.md step 7). A held source PR is left alone."""
    head = ISSUES["salvaged_from"].replace("#{pr}", "")
    src_rx = re.compile(re.escape(head) + r"(?:#|https://github\.com/" + re.escape(REPO) + r"/pull/)(\d+)", re.I)
    ours = gh(errors, "pr", "list", "-R", REPO, "--author", ME, "--state", "all", "--search", f'"{head.strip()}" in:body',
              "--limit", "1000", "--json", "number,state,body,mergedAt,closingIssuesReferences")
    ours = [p for p in ours if p["state"] == "OPEN" or (p["state"] == "MERGED" and (p["mergedAt"] or "") >= ISSUES["since"])]
    items, sources = [], {}
    for p in ours:
        for n in dict.fromkeys(int(x) for x in src_rx.findall(p["body"] or "")):
            if n not in sources:   # a source GitHub can't show (an issue number, a typo) only goes unchecked
                got = gh([], "pr", "view", str(n), "-R", REPO, "--json", "number,state,closingIssuesReferences")
                sources[n] = got if isinstance(got, dict) else None
            src = sources[n]
            if src is None:
                continue
            linked = {x["number"] for x in p.get("closingIssuesReferences") or []}
            want = [x["number"] for x in src.get("closingIssuesReferences") or [] if x["number"] not in linked]
            if p["state"] == "OPEN":
                if want:
                    items.append([f"salvage-fixes:{p['number']}:{n}", f"salvage cua#{p['number']} of cua#{n} lacks "
                                  + ", ".join(f"`{ISSUES['fixes'].format(issue=i)}`" for i in want) + " in its body: add it"])
                continue
            for i in want:
                st = gh([], "issue", "view", str(i), "-R", REPO, "--json", "state")
                if not isinstance(st, dict) or st.get("state") != "OPEN":
                    continue
                items.append([f"issue-open:{p['number']}:{i}", f"cua#{i} is still open: our merged salvage cua#{p['number']} fixed it "
                              f"but lacked `{ISSUES['fixes'].format(issue=i)}`; close it with a comment naming cua#{p['number']}"])
            if src["state"] == "OPEN" and n not in h["hold"]:
                items.append([f"salvaged-open:{n}:{p['number']}", f"cua#{n} is still open after its salvage cua#{p['number']} "
                              f"merged: close it with a comment naming cua#{p['number']} (playbooks/hourly.md step 7)"])
    return items


def task(c, h):
    head = f" at head {c['head']}" if c["head"] else ""
    if c["kind"] == "issue":
        return (f"trycua/cua#{c['n']}: {c['title']}\n{c['url']}\n\nKind: fix in trycua/cua, picked from the issues assigned to "
                f"{ME}. Read the issue and its thread, fix it with a test, and open a PR whose body says `Fixes #{c['n']}`.\n")
    if c["kind"] == "unstick":
        return (f"trycua/cua#{c['n']}{head}: {c['url']}\n\nKind: unstick our PR. The merge job waits on a session: {c['why']}. "
                "Update it from main, fix the cause, push, and have the verifier check the new head. "
                "If main or another PR already has its change, close it instead and say what replaced it.\n")
    who = "teammate (review-only: a first review and nothing else)" if c["author"]["login"] in h["review_only"] else \
        "outside contributor (salvage a fixable PR as a new PR of ours that credits them, instead of requesting changes)"
    frm, fixes = salvage_lines(c["n"])
    return (f"trycua/cua#{c['n']}{head} by {c['author']['login']}, a {who}: {c['title']}\n{c['url']}\n\nKind: first review, "
            f"requested of {ME}. Check the CLA first. Run playbooks/pull-requests.md Verify. Post nothing under Zane's "
            "name: put every comment or thank-you for the author under a `drafts:` section in report.md.\n"
            f"A salvage PR's body carries `{frm}` and a `{fixes}` line for each issue #{c['n']} fixes or was opened for "
            f"(`gh pr view {c['n']} -R {REPO} --json closingIssuesReferences`, and the issues its body names), "
            "so GitHub closes them when the salvage merges.\n")


# ---------------- the pass (the child) ----------------

# seen: needs-Zane and chat item keys a delivered wake carried, with when; unsent: collected results no wake delivered;
# failures: failed passes no wake delivered; authors: a launched review's author kind, for its drafts' list
EMPTY = {"seen": {}, "unsent": [], "failures": [], "authors": {}}


def state_path():
    return os.path.join(hourly.root(), "pickup", "state.json")


def read_state():
    try:
        s = json.load(open(state_path()))
        return {k: type(v)(s.get(k) or v) for k, v in EMPTY.items()}
    except (OSError, ValueError):
        return {k: type(v)() for k, v in EMPTY.items()}


ITEM = re.compile(r"\s*(?:[-*]|\d+[.)])\s+(.*)")


def sections(text):
    """report.md's PR links and its follow-ups:, questions: and drafts: lists ("none" is empty). A list is the text after
    its heading and the list items below it; an indented line continues the item above, and any other line ends it."""
    got, cur = {k: [] for k in SECTIONS}, None
    for line in text.splitlines():
        m = re.match(r"[\W_]*(follow-ups|questions|drafts)[*_`]*\s*:[*_`]*\s*(.*)", line, re.I)
        item = ITEM.match(line)
        if m:
            cur, line = m[1].lower(), m[2]
        elif cur and item:
            line = item[1]
        elif cur and line[:1].isspace() and line.strip() and got[cur]:
            got[cur][-1] = (got[cur][-1] + " " + line.strip())[:300]
            continue
        elif cur and line.strip():
            cur = None
        text_ = line.strip().strip("*_` ")
        if cur and text_ and text_.lower().rstrip(".") != "none":
            got[cur].append(text_[:300])
    return {"prs": list(dict.fromkeys(URL.findall(text))), **{k: v[:20] for k, v in got.items()}}


def collect(hosts, dry, state, errors):
    """Step 1: each ended run's report into the outbox, then its collect, one row each. A run whose report cannot be read
    is not collected: it stays exited, an error this pass, and the next pass reads it again."""
    for h, f in hosts.items():
        for sid, r in sorted(f.get("runs", {}).items()):
            if r["state"] not in ("exited", "lost"):
                continue
            rep = hourly.on(h, ["bin/hourly", "report", sid])
            if rep.returncode:
                errors.append(f"report {sid} on {h}: " + (rep.stderr.strip().splitlines() or [f"exit {rep.returncode}"])[-1][:150]
                              + "; not collected")
                continue
            res = {"id": sid, "host": h, "rc": r.get("rc"), "state": r["state"], "author": state["authors"].get(sid),
                   **sections(rep.stdout)}
            state["unsent"] = [x for x in state["unsent"] if (x["id"], x["host"]) != (sid, h)] + [res]   # a pass killed here redoes it
            if dry:   # in this pass's outbox only, so the plan's wake is the real pass's
                print(f"would collect {h} {sid}: rc={r.get('rc')}, prs {len(res['prs'])}")
                continue
            state["authors"].pop(sid, None)
            write(state_path(), state)
            p = hourly.on(h, ["bin/pi-run", "collect", sid])
            print(f"collect {h} {sid}: {(p.stdout or p.stderr).strip()[-200:]}")
            hourly.log(h, "collect", sid, f"rc={r.get('rc')}; prs {' '.join(res['prs']) or 'none'}; to the outbox")


def drain(dry):
    """Step 2: `bin/hourly queue` as its own process, its lines kept for the needs-Zane list. Not in this process: the
    drain holds slots.lock until it exits, and this pass's launches take that lock after it."""
    p = hourly.run([os.path.join(PKG, "bin", "hourly"), "queue"], env={**os.environ, **({"PI_RUN_DRY": "1"} if dry else {})})
    out = p.stdout + (f"queue: not drained (exit {p.returncode}): {p.stderr.strip().splitlines()[-1] if p.stderr.strip() else ''}\n"
                      if p.returncode else "")
    print(out, end="")
    return out.splitlines()


def taken_ids(hosts):
    """Every review id on any host, and every id a launch row names: a pruned review dir is still taken."""
    ids = {sid for f in hosts.values() for sid in f.get("ids", [])}
    try:
        ids |= {x.split("\t")[3] for x in open(os.path.join(hourly.root(), "pickup.log"), errors="replace")
                if x.split("\t")[2:3] == ["launch"]}
    except OSError:
        pass
    return ids


def run_pass(dry):
    state, errors = read_state(), []
    hosts = hourly.all_facts()
    collect(hosts, dry, state, errors)
    lines = drain(dry)
    hosts = hourly.all_facts() if not dry else hosts
    mh = hourly.HOST[0].get("ONIGIRI_MERGE_HOST")
    waits = hourly.merge_waits(errors)
    blind = hourly.unknown(hosts)
    h = holds((hosts.get(mh) or {}).get("holds")) if mh else holds("")
    if mh and "holds" not in hosts.get(mh, {}):
        errors.append(f"no holds file read on the merge host {mh}: nothing is picked this pass")
    def branch_of(n):   # a head GitHub cannot name leaves the PR's thread unknown: no unstick may be picked this pass
        got = hourly.branch_of(n)
        if got[0] == "unknown":
            errors.append(f"gh pr view {n}: its head and thread are unknown")
        return got
    owned = {int(n) for n, _, _, sid, _ in hourly.owners(hosts, [w for w in waits if " wait who=session: " in w], branch_of) if sid}
    cands = candidates(errors, waits, owned)
    prs = open_prs(errors)
    live = {n for f in hosts.values() for r in f.get("runs", {}).values() for n in r.get("nums", [])}
    zane = {int(w.split()[0][4:]) for w in waits if " wait who=zane: " in w}
    taken = taken_ids(hosts)
    free = 0 if errors else hourly.auto_free(hosts)   # none while a host is unknown
    todo = [c for c in cands if c["id"] not in taken]
    print(f"pickup {hourly.now()}: {len(todo)} candidates ({len(cands) - len(todo)} taken before), auto free {free}"
          + (f"; no picks: {'; '.join(blind + errors)}" if blind or errors else ""))
    if not dry:
        hourly.log(hourly.SELF, "pass", "-", f"pickup: candidates {len(todo)}, auto free {free}")
    for c in todo:
        if free <= 0:
            break
        why, there = rule(c, h, prs, live, zane, hosts)
        if why:
            print(f"skip {c['id']}: {why}")
            dry or hourly.log(hourly.SELF, "skip", c["id"], f"{why}; {c['url']}")
            continue
        if dry:
            print(f"would launch {there} {c['id']}: {c['kind']} {c['url']}")
            free -= 1
            continue
        brief = os.path.join(hourly.root(), "review", c["id"], "brief.md")
        if not os.path.exists(brief):   # a pass that died after new-brief left the brief: it launches as written
            nb = subprocess.run([os.path.join(PKG, "bin", "new-brief"), c["id"], "coding", "auto"], input=task(c, h),
                                capture_output=True, text=True)
            if nb.returncode:
                errors.append(f"new-brief {c['id']}: {nb.stderr.strip()[-150:]}")
                break
        rc = hourly.launch(c["id"], there, f"auto, {c['kind']} {c['url']}")
        if rc == 3:   # the auto pool filled since the count (a chat launch): bin/hourly logged the wait, the next pass picks
            break
        if rc == 0:
            free -= 1
            if c["kind"] == "review":   # its drafts go to the list for the author's kind when it is collected
                state["authors"][c["id"]] = "teammate" if c["author"]["login"] in h["review_only"] else "outside"
                write(state_path(), state)
        else:
            errors.append(f"launch {c['id']} on {there} failed")
            break
    salvages = salvage_check(errors, h)   # before the report, so a GitHub read it could not make is a needs-Zane error
    out = report(hosts, waits, lines, errors)
    out["chat"] += salvages
    return {**out, **({"unsent": state["unsent"]} if dry else {})}


def report(hosts, waits, lines, errors):
    """The lists, as [key, text]: the key is what makes an item the same item next pass."""
    needs, chat = [], []
    for x in waits:
        if " wait who=zane: " in x:
            needs.append([f"wait:{x.split()[0]}:{x.split()[1]}", x.replace(" wait who=zane", "")])
    for x in lines:
        if "needs Zane" in x:
            needs.append([f"queue:{x.split(':')[0]}", x])
    for name, f in hosts.items():
        if "error" in f:
            needs.append([f"host:{name}:unreachable", f"host {name} unreachable: {f['error']}"])
            continue
        if not f.get("at_main"):
            needs.append([f"host:{name}:{f.get('sha')}", f"host {name} not at main: {'; '.join(f.get('parity', []))}"])
        if f.get("free_gb", 0) < hourly.FLOOR_GB:   # the chat prunes without asking (playbooks/hourly.md, Decide or ask)
            chat.append([f"disk:{name}", f"host {name}: {f.get('free_gb')}G free, under {hourly.FLOOR_GB}G: prune it"])
        for sid, r in f.get("runs", {}).items():
            if r.get("idle_min", 0) >= hourly.HUNG_MIN:
                chat.append([f"hung:{name}:{sid}", f"{sid} on {name}: running, no log or session write for {r['idle_min']}m"])
    mh = hourly.HOST[0].get("ONIGIRI_MERGE_HOST")
    if mh in hosts and "error" not in hosts[mh]:
        st, line = hourly.merge_health(hosts[mh].get("merge_last"))
        if st != "ok":
            needs.append([f"merge:{st}", f"merge job {st}: {line}"])
    for e in errors:
        needs.append(["error:" + re.sub(r"\d+", "N", e)[:80], f"error: {e}"])
    return {"needs": needs, "chat": chat}


# ---------------- the parent: lock, deadline, wake ----------------

def write(p, obj):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p + ".tmp", "w") as f:
        json.dump(obj, f, indent=1, sort_keys=True)
    os.replace(p + ".tmp", p)


def lists(state, out):
    """The four lists the chat's pass returned, and `chat` for what it decided itself, from the outbox and the pass."""
    res, out = state["unsent"], out or {}
    drafts = lambda who: [f"{r['id']}: {d}" for r in res if (r.get("author") == "teammate") == who for d in r.get("drafts", [])]  # noqa: E731
    return {
        "needs-Zane": [f"an earlier pass failed and its wake was not delivered: {x}" for x in state["failures"]]
        + [t for _, t in out.get("needs", [])] + [f"{r['id']}: {q}" for r in res for q in r.get("questions", [])],
        "dumpling results": [f"{r['id']} on {r['host']}: {'lost' if r['state'] == 'lost' else 'rc=' + str(r['rc'])}; "
                             f"PRs {' '.join(r['prs']) or 'none'}" for r in res],
        "outside-contributor drafts": drafts(False),
        "teammate comment drafts": drafts(True),
        "chat": [t for _, t in out.get("chat", [])] + [f"{r['id']} follow-up to file: {x}" for r in res for x in r.get("follow-ups", [])],
    }


def deliver(state, out, failed, dry, ts):
    """Step 5. Returns the wake's status line, or None when the pass had nothing new to say."""
    keys = {k: t for k, t in ((out or {}).get("needs", []) + (out or {}).get("chat", []))}
    if out is not None:   # an item that went away is dropped, so its return is news (model/Pickup.tla StandingFlips)
        state["seen"] = {k: v for k, v in state["seen"].items() if k in keys}
    new = [k for k in keys if k not in state["seen"]]
    if not (state["unsent"] or state["failures"] or new or failed):
        return None
    L = lists(state, out)
    body = [f"# pickup pass {ts} on {hourly.SELF}, zstack {pr.sha()}", ""]
    if failed:
        body += [f"**failed**: {failed}", ""]
    for name, items in L.items():
        body += [f"{name}:"] + [f"- {x}" + (" (new)" if any(t == x and k in new for k, t in keys.items()) else "") for x in items] \
            + (["- none"] if not items else []) + [""]
    path = os.path.join(hourly.root(), "pickup", f"pass-{ts.replace(':', '')}.md")
    if not dry:
        with open(path, "w") as f:
            f.write("\n".join(body))
    msg = (f"pickup {'failed: ' + failed + '. ' if failed else ''}" + "; ".join(f"{n} {len(v)}" for n, v in L.items() if v)
           + (f" ({len(new)} new)" if new else "") + ". " + " | ".join(x for v in L.values() for x in v))[:1000]
    prs = sorted({u for r in state["unsent"] for u in r.get("prs", [])})
    if dry:
        print("\n".join(body))
        return f"would send {'failed' if failed else 'done'}: {msg} (dry run, nothing sent)"
    cmd = [os.environ.get("ONIGIRI_WAKE") or os.path.join(PKG, "hosts", "vm", "wake.py"), "failed" if failed else "done", msg,
           f"report={path}", *([f"prs={','.join(prs)}"] if prs else [])]
    p = hourly.run(cmd, env={**os.environ, "PI_SESSION_ID": "pickup"})
    status = next((x.split(" ", 2)[2] for x in p.stderr.splitlines() if x.startswith("wake: ")), f"wake exited {p.returncode}")
    if status.startswith("webhook sent"):
        now = hourly.now()
        state["unsent"], state["failures"] = [], []
        if out is not None:   # only a pass that reached its report knows which items stand
            state["seen"] = {k: state["seen"].get(k, now) for k in keys}
    elif failed:   # the next pass says it again (model/Pickup.tla WakeFails)
        state["failures"].append(f"{ts}: {failed}")
    return status


def main(argv):
    print(f"zstack {pr.sha()}", file=sys.stderr)
    if argv not in ([], ["--dry"]):
        pr.die(2, "usage: pickup [--dry]")
    dry = argv == ["--dry"]
    pr.on_main(argv, __file__)
    os.environ["ZSTACK_ENSURED"] = "1"   # the package is at main for this pass: the launches it starts here do not move it
    if not dry:
        d = os.path.join(hourly.root(), "pickup")
        os.makedirs(d, exist_ok=True)
        lock = os.open(os.path.join(d, "pickup.lock"), os.O_RDWR | os.O_CREAT, 0o644)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            hourly.log(hourly.SELF, "pass-locked", "-", "another pickup pass holds the lock; this one did nothing")
            return print("pickup: another pass holds the lock; nothing done") or 0
    ts = hourly.now()
    sys.stdout.flush()
    sys.stderr.flush()
    rfd, wfd = os.pipe()   # the child's report comes back on a pipe: a pass leaves no scratch file, dry or not
    child = os.fork()
    if child == 0:
        os.close(rfd)
        os.setpgid(0, 0)
        try:
            out = json.dumps(run_pass(dry)).encode()
            sys.stdout.flush()
            while out:
                out = out[os.write(wfd, out):]
            os._exit(0)
        except BaseException:   # noqa: BLE001  the parent reports the pass as failed with this traceback in the log
            import traceback
            traceback.print_exc()
            sys.stderr.flush()
            os._exit(1)
    os.close(wfd)
    try:
        os.setpgid(child, child)   # as the child does, so a kill at the deadline cannot miss its group
    except OSError:
        pass
    deadline = int(os.environ.get("PICKUP_DEADLINE_S") or CFG["deadline_s"])
    failed, end, got = None, time.monotonic() + deadline, []
    os.set_blocking(rfd, False)
    while True:
        try:   # drain the pipe as the child writes, so a report larger than the pipe buffer never blocks it
            while chunk := os.read(rfd, 1 << 16):
                got.append(chunk)
        except BlockingIOError:
            pass
        pid, status = os.waitpid(child, os.WNOHANG)
        if pid:
            failed = None if os.waitstatus_to_exitcode(status) == 0 else f"the pass exited {os.waitstatus_to_exitcode(status)}"
            break
        if time.monotonic() > end:
            reaped = False
            for sig, grace in ((signal.SIGTERM, 10), (signal.SIGKILL, 5)):
                try:
                    os.killpg(child, sig)
                except OSError:
                    pass
                stop = time.monotonic() + grace
                while not reaped and time.monotonic() < stop:
                    reaped = bool(os.waitpid(child, os.WNOHANG)[0])
                    time.sleep(0 if reaped else 0.2)
            failed = f"the pass hit its {deadline}s deadline and was killed"
            break
        time.sleep(0.2)
    out = None
    if not failed:
        os.set_blocking(rfd, True)
        while chunk := os.read(rfd, 1 << 16):
            got.append(chunk)
        try:
            out = json.loads(b"".join(got))
        except ValueError as e:
            failed = f"the pass left no report: {e}"
    os.close(rfd)
    state = read_state()
    if dry and out:   # the dry child's outbox, with the results it would have collected
        state["unsent"] = out.pop("unsent", state["unsent"])
    status = deliver(state, out, failed, dry, ts)
    if not dry:
        write(state_path(), state)
        hourly.log(hourly.SELF, "pass-end", "-", f"{'failed: ' + failed + '; ' if failed else ''}wake: {status or 'none, nothing new'}")
    print(f"pickup: {'failed: ' + failed + '; ' if failed else ''}wake: {status or 'none, nothing new'}")
    return 1 if failed else 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
